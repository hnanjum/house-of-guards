---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Root-relative or absolute URL of a share-preview image (articles). */
  image?: string;
  /** "article" on Insights posts; "website" everywhere else. */
  ogType?: "website" | "article";
}

const {
  title,
  description = "Harley Garrison — SIA-licensed manned guarding, close protection, CCTV monitoring, and mobile patrols for corporate and high-net-worth clients, based in Bradford, West Yorkshire.",
  image,
  ogType = "website",
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0d0d0d" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Harley Garrison" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <slot name="head" />
    <link rel="sitemap" href="/sitemap.xml" />
    <title>{title} | Harley Garrison</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSmoothScroll } from "../lib/smoothScroll";

      // Re-run on every hard load and every View Transitions navigation.
      document.addEventListener("astro:page-load", () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
