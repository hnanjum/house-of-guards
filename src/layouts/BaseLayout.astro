---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "House of Guards — SIA-licensed manned guarding, close protection, CCTV monitoring, and mobile patrols for corporate and high-net-worth clients, based in Bradford, West Yorkshire.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title} | House of Guards</title>
    <ClientRouter />
  </head>
  <body class="flex min-h-screen flex-col bg-paper text-ink">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      import { initSmoothScroll } from "../lib/smoothScroll";

      // Re-run on every hard load and every View Transitions navigation.
      document.addEventListener("astro:page-load", () => {
        initSmoothScroll();
      });
    </script>
  </body>
</html>
