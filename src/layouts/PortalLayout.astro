---
import "../styles/global.css";

/**
 * Shell for the signed-in portals (officers / admin / client). Same
 * tokens and fonts as the public site, but none of its chrome: no
 * marketing header/footer, no smooth scroll, no view transitions, and
 * never indexed. The portal app itself renders client-side only.
 */
interface Props {
  title: string;
  /** Installable app (officers): web manifest + home-screen icon. */
  installable?: boolean;
}

const { title, installable = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2563eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {
      installable && (
        <>
          <link rel="manifest" href="/officers.webmanifest" />
          <link rel="apple-touch-icon" href="/officers-apple-touch.png" />
          <meta name="apple-mobile-web-app-capable" content="yes" />
          <meta name="apple-mobile-web-app-title" content="HG Officers" />
        </>
      )
    }
    <title>{title} | Harley Garrison</title>
    {/* Apply the remembered light/dark choice before first paint (see portal/theme.tsx). */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem("hg.ui.theme");
          if (t !== "dark") t = "light";
          document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-paper text-ink min-h-dvh">
    <slot />
  </body>
</html>
