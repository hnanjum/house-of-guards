---
/**
 * Functional header/footer icon only — not a brand mark. Deliberately
 * breaks the service marks' square/miter rule (rounded caps/joins
 * here instead) — same reasoning as Location.astro: it needs to read
 * instantly as the universal phone-handset pictogram, and forcing it
 * into the brand's harder geometric language would cost
 * recognisability for no real benefit here.
 *
 * REDRAWN: the original version (two plain circles joined by a curve)
 * read as abstract dots, not a phone, per real feedback against the
 * live site. This uses the real, widely-deployed Feather Icons
 * "phone" glyph path verbatim (a genuine handset silhouette) rather
 * than a fresh hand-drawn shape — kept in its native 24×24 viewBox
 * instead of risking a hand-scaled/re-transcribed copy into this
 * set's usual 40×40 (a real transcription-error risk with no way to
 * visually re-check it here). `stroke-width` is scaled to the same
 * proportion as the 40×40/1.25 icons (1.25/40 = 0.75/24), so it reads
 * at an identical visual weight despite the different native viewBox
 * — confirmed the two ratios are exactly equal, not just close.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="0.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path
    d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"
  />
</svg>
