---
/**
 * Functional header icon only — not a brand mark. Deliberately breaks
 * the service marks' square/miter rule (rounded caps/joins here
 * instead), for the same reason Phone.astro does: it needs to read
 * instantly as the universal map-pin pictogram, and forcing it into
 * the brand's harder geometric language would cost recognisability for
 * no real benefit here.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d="M20 6c-6.6 0-12 5.3-12 11.8C8 26.5 20 35 20 35s12-8.5 12-17.2C32 11.3 26.6 6 20 6Z" />
  <circle cx="20" cy="17.5" r="4.5" />
</svg>
