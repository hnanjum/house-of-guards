---
/**
 * "Night Patrol" — a crescent above a dashed patrol route with waypoint
 * markers. Night plus movement, not a decorative moon alone.
 *
 * The three waypoint dots are the one deliberate exception to this
 * icon set's stroke-only rule — a 1px-radius stroked circle at this
 * stroke-width renders as a faint blob rather than a clean dot, so they
 * are small solid fills instead.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <path d="M17 7 A7 7 0 1 0 17 21 A5 5 0 1 1 17 7 Z" />
  <path d="M7 33 Q20 29 33 33" stroke-dasharray="2 2" />
  <circle cx="13" cy="30.5" r="1" fill="currentColor" stroke="none" />
  <circle cx="20" cy="29.3" r="1" fill="currentColor" stroke="none" />
  <circle cx="27" cy="30.5" r="1" fill="currentColor" stroke="none" />
</svg>
