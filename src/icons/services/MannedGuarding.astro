---
/**
 * "Patrol" — two offset footprints (a narrow-heel/wide-ball sole
 * ellipse, PLUS a separate cluster of three small solid toe-dots
 * offset above it with a real visible gap — the standard footprint
 * pictogram convention, not a hand-invented shape), rotated in
 * opposite directions mid-stride so they read as a walked route
 * rather than a static mark. Deliberately NOT a standing-figure
 * concept (Close Protection already owns "a figure" in this six-icon
 * set — see that icon's own comment) and deliberately NOT anything
 * card/rectangle-shaped, per explicit instruction: this must stay
 * visually distinct from `src/icons/stats/Credential.astro` (the
 * ID-card mark StatStrip uses for "SIA") — a footprint motif shares no
 * silhouette family with a rectangular card at all.
 *
 * A first draft (sole ellipse + ONE larger toe-circle sitting flush
 * against/overlapping the sole) was rasterised and rejected in the
 * mandatory check before this version shipped — it read as a
 * figure-8/snowman, not a foot, at both real display size and
 * magnified. The fix wasn't a tuning pass on that shape, it was
 * switching to a genuinely different, well-established convention
 * (three small SEPARATE toe-dots with a real gap above the sole,
 * matching how footprint pictograms are conventionally drawn
 * elsewhere) — re-verified against the same rasterised check before
 * shipping this geometry.
 *
 * The toe-dots are solid fills, not stroked outlines — same
 * established exception as this icon set's other small circular
 * details (OvernightSecurity's old waypoint dots, CctvMonitoring's
 * lens centre): a circle this small renders as a faint ring rather
 * than a clean dot at this stroke weight if left unfilled.
 *
 * Colour inherits via `currentColor` — see CorporateSecurity.astro's
 * own comment for the full colour/stroke-width rationale, identical
 * here.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <g transform="rotate(-14 14 25)">
    <ellipse cx="14" cy="27" rx="3.4" ry="6.2" />
    <circle cx="11.8" cy="17" r="1.3" fill="currentColor" stroke="none" />
    <circle cx="14.2" cy="15.6" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="16.6" cy="17" r="1.3" fill="currentColor" stroke="none" />
  </g>
  <g transform="rotate(14 27 15)">
    <ellipse cx="27" cy="17" rx="3.4" ry="6.2" />
    <circle cx="24.8" cy="7" r="1.3" fill="currentColor" stroke="none" />
    <circle cx="27.2" cy="5.6" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="29.6" cy="7" r="1.3" fill="currentColor" stroke="none" />
  </g>
</svg>
