---
/**
 * "Threshold" — an open door-frame with a single figure standing at its
 * base. A person stationed at an access point.
 *
 * Color is intentionally NOT set here — it inherits from the parent's
 * text colour via `currentColor` (Ink by default, Guard Green when the
 * containing service row is open).
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <path d="M10 34 L10 6 L30 6 L30 34" />
  <circle cx="20" cy="18" r="2.5" />
  <path d="M16 33 L18 22 L22 22 L24 33 Z" />
</svg>
