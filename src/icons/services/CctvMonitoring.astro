---
/**
 * "Field of View" — a wall-mounted box camera with a diverging view
 * cone. The only mechanical/directional mark in the set.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <path d="M9 10 L9 17 L15 17" />
  <rect x="15" y="14" width="12" height="6" />
  <circle cx="27" cy="17" r="1.6" />
  <path d="M30 17 L37 10" />
  <path d="M30 17 L37 24" />
</svg>
