---
/**
 * "Camera" — a wall-mounted box camera: a rounded rectangular body, a
 * circular lens with a small solid centre dot, and a short mounting
 * arm at the back. Simplified from the old accordion-only "Field of
 * View" concept (which added a diverging view-cone of two long lines)
 * — at this icon's larger on-card size a bare camera body silhouette
 * already reads unambiguously on its own; the extra cone lines tested
 * as visual clutter rather than added clarity in the mandatory
 * rasterised check.
 *
 * The lens's solid centre dot is the one deliberate stroke-only-rule
 * exception in this set, same precedent as the old OvernightSecurity
 * accordion icon's waypoint dots — a small circle at this stroke
 * weight renders as a faint ring rather than a clean dot if left
 * unfilled.
 *
 * Colour inherits via `currentColor` — see CorporateSecurity.astro's
 * own comment for the full colour/stroke-width rationale, identical
 * here.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <path d="M9 15 L9 10 L14 10" />
  <rect x="9" y="15" width="17" height="9" rx="1" />
  <circle cx="30" cy="19.5" r="4" />
  <circle cx="30" cy="19.5" r="1.4" fill="currentColor" stroke="none" />
</svg>
