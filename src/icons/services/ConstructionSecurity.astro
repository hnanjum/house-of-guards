---
/**
 * "Barrier" — a lowered boom barrier with hazard-stripe ticks across the
 * arm. Controlled access to an active site.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <line x1="8" y1="33" x2="8" y2="13" />
  <line x1="8" y1="13" x2="33" y2="15" />
  <line x1="33" y1="15" x2="33" y2="19" />
  <line x1="13" y1="11" x2="15.5" y2="15.5" />
  <line x1="18" y1="11.3" x2="20.5" y2="15.8" />
  <line x1="23" y1="11.6" x2="25.5" y2="16.1" />
  <line x1="28" y1="11.9" x2="30.5" y2="16.4" />
</svg>
