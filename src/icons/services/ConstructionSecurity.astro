---
/**
 * "Hard Hat" — a classic dome-and-brim safety helmet silhouette: an
 * arced dome, a rounded brim band along the base, and a single centre
 * ridge line down the dome (a real, recognisable hard-hat detail, not
 * decoration for its own sake). Replaces the old accordion-only
 * "Barrier" concept (a lowered boom barrier with hazard-stripe ticks)
 * outright — the barrier read correctly at the accordion's small Ink/
 * Green-on-white size but the hazard-stripe ticks lost definition once
 * rasterised at this icon's larger on-card size and heavier stroke
 * weight in the mandatory check; a hard hat is also the more literal,
 * immediately-legible "construction site" mark of the two.
 *
 * Colour inherits via `currentColor` — see CorporateSecurity.astro's
 * own comment for the full colour/stroke-width rationale, identical
 * here.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <path d="M10 24 A10 10 0 0 1 30 24" />
  <path d="M7 24 L33 24 A2 2 0 0 1 33 27 L7 27 A2 2 0 0 1 7 24 Z" />
  <line x1="20" y1="14" x2="20" y2="24" />
</svg>
