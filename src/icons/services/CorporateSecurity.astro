---
/**
 * "Perimeter" — a stepped office-tower silhouette with a wide ground
 * line at its base. Protecting a place of business, not a person.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <rect x="13" y="11" width="14" height="23" />
  <rect x="16" y="5" width="8" height="6" />
  <line x1="16" y1="17" x2="24" y2="17" />
  <line x1="16" y1="22" x2="24" y2="22" />
  <line x1="16" y1="27" x2="24" y2="27" />
  <line x1="9" y1="34" x2="31" y2="34" />
</svg>
