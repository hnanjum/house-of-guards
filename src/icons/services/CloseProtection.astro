---
/**
 * "Watching Over" — a single standing figure inside a wide OPEN arc
 * (roughly 220° of a circle, gapped at the bottom where the figure's
 * feet meet the ground). Deliberately NOT a closed ring and NOT a
 * shield outline (the latter is permanently banned project-wide, see
 * CLAUDE.md's hard rules) — an open arc reads as coverage/attention
 * directed at someone, not armour worn by them. Replaces the old
 * accordion-only "Escort" concept (two figures + a shallow arc) with a
 * single figure so the "who is being protected" reading stays
 * unambiguous at this icon's larger, bolder on-card display size.
 *
 * The arc is a single elliptical-arc path command (`A16 16 0 1 1 …`),
 * not two half-circles glued together — computed directly from the
 * circle's own centre/radius so the two open ends land symmetrically
 * either side of the figure, not eyeballed.
 *
 * Colour inherits via `currentColor` — see CorporateSecurity.astro's
 * own comment for the full colour/stroke-width rationale, identical
 * here.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <circle cx="20" cy="14" r="3" />
  <path d="M15 30 L17 20 L23 20 L25 30 Z" />
  <path d="M5 25.5 A16 16 0 1 1 35 25.5" />
</svg>
