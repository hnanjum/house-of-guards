---
/**
 * "Escort" — two figures, one set back and higher than the other,
 * cradled by a shallow protective arc. Proximity, not just presence.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <circle cx="14" cy="17" r="2.3" />
  <path d="M10 31 L12 22 L16 22 L18 31 Z" />
  <circle cx="25" cy="14" r="2.3" />
  <path d="M21 29 L23 19 L27 19 L29 29 Z" />
  <path d="M8 33 Q20 38 32 33" />
</svg>
