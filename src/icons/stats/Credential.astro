---
/**
 * "Credentialed officer" — an ID/licence card, not a shield or
 * checkmark (both permanently banned on this project). A photo circle
 * + two detail lines stand in for name/licence-number fields, a
 * divider separates that identity block from a small first-aid cross
 * lower on the card — the cross is one detail among several, not the
 * icon's whole subject, so it reads as "a real credential that
 * includes first-aid certification" rather than a generic medical
 * icon. Pairs the "SIA" label and "Supplying highly trained, SIA-
 * licensed, and fully vetted professional officers you can trust"
 * body — SIA licences are literally physical wallet-card IDs, so this
 * is a specific, not a generic, choice for this stat.
 *
 * 40×40 viewBox, square caps, miter joins — matches Clock.astro and
 * Growth.astro, this component's current icon set (the earlier
 * Calendar/Support icons this one used to sit alongside were removed
 * once "bespoke shift patterns" and "24/7 phone... support" stopped
 * being the captions here; this shape and its own concept are
 * unaffected by that and carried forward unchanged into the new set).
 *
 * `stroke-width="1.5"` — this icon set sits plain on the section's
 * own solid Guard Green Secondary fill (no badge behind it, unlike an
 * earlier pass of this component), sized to read as a genuine
 * "medium" mark rather than the original thin bare-line weight or the
 * heavier badge-context weight used at other points in this
 * component's history. Rasterised and visually inspected (magnified,
 * and alongside Clock.astro and Growth.astro at real deployed size)
 * before shipping this weight, same as every icon in this family.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <rect x="8" y="7" width="24" height="26" rx="1.5" />
  <circle cx="14" cy="15" r="3.25" />
  <line x1="20" y1="13" x2="28" y2="13" />
  <line x1="20" y1="17" x2="26" y2="17" />
  <line x1="11" y1="22" x2="29" y2="22" />
  <line x1="20" y1="25" x2="20" y2="31" />
  <line x1="17" y1="28" x2="23" y2="28" />
</svg>
