---
/**
 * "Credentialed officer" — an ID/licence card, not a shield or
 * checkmark (both permanently banned on this project). A photo circle
 * + two detail lines stand in for name/licence-number fields, a
 * divider separates that identity block from a small first-aid cross
 * lower on the card — the cross is one detail among several, not the
 * icon's whole subject, so it reads as "a real credential that
 * includes first-aid certification" rather than a generic medical
 * icon. Pairs "Every officer SIA-licensed & first-aid trained" —
 * SIA licences are literally physical wallet-card IDs, so this is a
 * specific, not a generic, choice for this stat.
 *
 * Same 40×40 viewBox / square caps / miter joins as the six service
 * icons in `src/icons/services/` — designed as one deliberate set
 * alongside Calendar.astro and Support.astro (consistent weight/
 * complexity, not three independently-styled icons).
 *
 * `stroke-width="2"` (was `1.25` in the original bare-line version of
 * this set) — bumped specifically for this icon's current context:
 * a white mark on a solid Guard Green Secondary circular badge, where
 * the original house-icon weight read thin once tested at real size
 * (see StatStrip.astro's own comment for the badge treatment this
 * feeds into). These icons have no other usage site, so the weight
 * was changed directly here rather than kept at 1.25 for a bare-line
 * context that no longer exists anywhere in this codebase.
 * Rasterised and visually inspected (individually, magnified, and
 * side by side with the other two, both as bare lines originally and
 * again inside the badge treatment) before shipping either version —
 * see the PR description for what was checked.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <rect x="8" y="7" width="24" height="26" rx="1.5" />
  <circle cx="14" cy="15" r="3.25" />
  <line x1="20" y1="13" x2="28" y2="13" />
  <line x1="20" y1="17" x2="26" y2="17" />
  <line x1="11" y1="22" x2="29" y2="22" />
  <line x1="20" y1="25" x2="20" y2="31" />
  <line x1="17" y1="28" x2="23" y2="28" />
</svg>
