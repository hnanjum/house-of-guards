---
/**
 * "Credentialed officer" — an ID/licence card, not a shield or
 * checkmark (both permanently banned on this project). A photo circle
 * + two detail lines stand in for name/licence-number fields, a
 * divider separates that identity block from a small first-aid cross
 * lower on the card — the cross is one detail among several, not the
 * icon's whole subject, so it reads as "a real credential that
 * includes first-aid certification" rather than a generic medical
 * icon. Pairs "Every officer SIA-licensed & first-aid trained" —
 * SIA licences are literally physical wallet-card IDs, so this is a
 * specific, not a generic, choice for this stat.
 *
 * Same house style as the six service icons in `src/icons/services/`
 * — 40×40 viewBox, `stroke-width="1.25"`, square caps, miter joins,
 * unfilled — designed as one deliberate set alongside Calendar.astro
 * and Support.astro (consistent weight/complexity, not three
 * independently-styled icons). Rasterised and visually inspected
 * (individually, magnified, and side by side with the other two) at
 * both the actual deployed 32px size and a magnified 200px size
 * before shipping — see the PR description for what was checked and
 * why the first draft of the third icon in this set was redrawn.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1.25"
  stroke-linecap="square"
  stroke-linejoin="miter"
  class={className}
  aria-hidden="true"
>
  <rect x="8" y="7" width="24" height="26" rx="1.5" />
  <circle cx="14" cy="15" r="3.25" />
  <line x1="20" y1="13" x2="28" y2="13" />
  <line x1="20" y1="17" x2="26" y2="17" />
  <line x1="11" y1="22" x2="29" y2="22" />
  <line x1="20" y1="25" x2="20" y2="31" />
  <line x1="17" y1="28" x2="23" y2="28" />
</svg>
