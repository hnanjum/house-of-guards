---
import NavLink from "./ui/NavLink.astro";
import Divider from "./ui/Divider.astro";
import Phone from "../icons/Phone.astro";
import Email from "../icons/Email.astro";
import Chevron from "../icons/Chevron.astro";
import { SECTORS } from "../data/sectors";

/**
 * Site footer. Solid dark neutral grey (--color-footer-grey), not
 * green and not black, so it reads as its own zone rather than a third
 * green band or a slide into pure ink. Three loose columns (identity /
 * navigate / contact), no mega-footer link grid.
 *
 * `on-dark` swaps the focus ring to white (see global.css).
 *
 * NOTE: phone number and email below are clearly-marked placeholders
 * (repeated zeros / a generic domain pattern), not real contact
 * details — swap both for the real ones before launch.
 */
const year = new Date().getFullYear();

// Two link menus — Quick links and Sectors (each sector's own detail
// page). On direct instruction from the owner: left-aligned columns on
// desktop as before, but centred and collapsed into open/close
// accordions at phone width. Company name/number in the bottom bar are
// the real Companies House details.
const MENUS: { id: string; title: string; links: [string, string][] }[] = [
  {
    id: "links",
    title: "Quick links",
    links: [
      ["/about", "About Us"],
      ["/services", "Services"],
      ["/careers", "Careers"],
      ["/contact", "Get a Quote"],
    ],
  },
  {
    id: "sectors",
    title: "Sectors",
    links: SECTORS.map((sector) => [`/sectors/${sector.slug}`, sector.name] as [string, string]),
  },
];---

<footer class="on-dark bg-ink">
  <div class="mx-auto max-w-7xl px-gutter py-16 md:px-12">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1.3fr] md:gap-10">
      <div class="text-center md:text-left">
        <a href="/" aria-label="Harley Garrison, home" class="inline-block">
          <img src="/logo/logo-white.svg" alt="Harley Garrison" width="148" height="40" class="h-10 w-auto" />
        </a>
        <p class="text-caption text-paper/70 mx-auto mt-4 max-w-xs md:mx-0">
          SIA-licensed manned guarding, close protection, CCTV monitoring, and
          mobile patrols for corporate and high-net-worth clients across
          Yorkshire and the North West.
        </p>
      </div>

      <div class="md:contents">
        {MENUS.map((menu, m) => (
          <nav
            aria-label={menu.title}
            data-footer-menu
            data-open="true"
            class:list={["group/menu border-b border-paper/15 text-center md:border-0 md:text-left", m === 0 && "border-t"]}
          >
            <p class="text-caption text-paper/70 mb-4 hidden md:block">{menu.title}</p>
            <button
              type="button"
              data-footer-menu-toggle
              aria-expanded="true"
              aria-controls={`footer-menu-${menu.id}`}
              class="flex w-full items-center justify-center gap-2 py-4 text-caption text-paper md:hidden"
            >
              {menu.title}
              <Chevron class="size-4 shrink-0 rotate-90 transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[open=true]/menu:-rotate-90" />
            </button>
            <div
              id={`footer-menu-${menu.id}`}
              class="grid grid-rows-[0fr] invisible transition-[grid-template-rows,visibility] duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] group-data-[open=true]/menu:grid-rows-[1fr] group-data-[open=true]/menu:visible md:visible md:grid-rows-[1fr]"
            >
              <ul class="min-h-0 space-y-3 overflow-hidden transition-[padding] duration-500 max-md:group-data-[open=true]/menu:pb-5 md:overflow-visible">
                {menu.links.map(([href, label], i) => (
                  <li
                    class="translate-y-2 opacity-0 transition-[opacity,translate] duration-500 ease-out group-data-[open=true]/menu:translate-y-0 group-data-[open=true]/menu:opacity-100 md:translate-y-0 md:opacity-100"
                    style={`transition-delay: ${60 + i * 45}ms`}
                  >
                    <NavLink href={href} tone="paper" size="sm">{label}</NavLink>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        ))}
      </div>

      <div class="text-center md:text-left">
        <p class="text-micro text-paper/70">Bradford, West Yorkshire</p>
        <a
          href="tel:+441274000000"
          class="mt-4 flex items-center justify-center gap-2 text-caption text-paper transition-colors md:justify-start duration-200 ease-out hover:text-paper/70"
        >
          <Phone class="size-4 shrink-0" />
          01274 000 000
        </a>
        <a
          href="mailto:info@harleygarrison.co.uk"
          class="mt-3 flex items-center justify-center gap-2 text-caption text-paper transition-colors md:justify-start duration-200 ease-out hover:text-paper/70"
        >
          <Email class="size-4 shrink-0" />
          info@harleygarrison.co.uk
        </a>
      </div>
    </div>

    <Divider tone="paper" class="mt-16" />

    <div class="flex flex-col items-center gap-2 pt-8 text-center sm:flex-row sm:justify-between sm:text-left">
      <p class="text-micro text-paper/70">&copy; {year} Harley Garrison. All rights reserved.</p>
      <p class="text-micro text-paper/70">
        Harley Garrison Ltd · Registered in England and Wales · Company number 17508784
      </p>
    </div>
  </div>
</footer>

<script>
  // Phone-width accordions for the footer menus. The markup ships OPEN so
  // the links are reachable without JavaScript; this closes it on phones
  // once the script runs (the footer is off-screen at load, so nothing
  // visibly snaps). At md+ the panel is always shown by CSS and the
  // toggle button is hidden, so data-open has no visible effect there.
  // The motion is plain CSS transitions, covered by global.css's
  // prefers-reduced-motion reset.
  function initFooterMenu() {
    const phone = !window.matchMedia("(min-width: 48rem)").matches;
    document.querySelectorAll<HTMLElement>("[data-footer-menu]").forEach((menu) => {
      const toggle = menu.querySelector<HTMLButtonElement>("[data-footer-menu-toggle]");
      if (!toggle || menu.dataset.ready) return;
      menu.dataset.ready = "true";

      const set = (open: boolean) => {
        menu.dataset.open = String(open);
        toggle.setAttribute("aria-expanded", String(open));
      };
      if (phone) set(false);
      toggle.addEventListener("click", () => set(menu.dataset.open !== "true"));
    });
  }
  document.addEventListener("astro:page-load", initFooterMenu);
</script>
