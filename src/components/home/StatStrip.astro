---
import Divider from "../ui/Divider.astro";
import Clock from "../../icons/stats/Clock.astro";
import Credential from "../../icons/stats/Credential.astro";
import Growth from "../../icons/stats/Growth.astro";

/**
 * Third redesign of this section. Content, background, alignment, and
 * icon treatment ALL change this pass — this is closer to a rebuild
 * than a restyle, per direct instruction.
 *
 * CONTENT — the old three captions ("Every officer SIA-licensed...",
 * "Bespoke shift patterns...", "24/7 phone and on-shift...") are
 * deleted, not kept alongside the new copy. Each column is now a real
 * three-part unit — icon, a short bold `<h3>` label, a full-sentence
 * body paragraph below it — not icon+single-caption like every
 * earlier version of this component.
 *
 * ALIGNMENT — LEFT-aligned on `sm:`+ (reverting the previous pass's
 * "third sanctioned centred-alignment exception" — CLAUDE.md's own
 * hard-rule bullet is reverted in the same commit back to "exactly
 * two," MissionBand/ClosingCta, so code and rules document agree
 * again). CENTRED below `sm:` — a real, later, explicit follow-up
 * instruction specific to the stacked mobile layout, not a re-opening
 * of the left-vs-centre question this component's own history already
 * went back and forth on for the desktop row. `items-center text-
 * center sm:items-start sm:text-left` on each column.
 *
 * TEXT SIZE — both the label and the body were reduced one named tier
 * per direct follow-up feedback that the first version of this pass
 * read too large: label `text-h3` (28px) → `text-body-lg` (20px);
 * body `text-body` (17px) → `text-caption` (14px). Same "read the
 * current class, step down one tier on the 8-step scale" discipline
 * already used twice on the Hero. One real, disclosed quirk this
 * surfaced: `text-caption`'s own weight (500) is actually HEAVIER than
 * `text-body-lg`'s (400) — the two type-scale steps aren't
 * monotonically weighted by size — so the BODY text is technically a
 * touch bolder than the LABEL above it now, the opposite of the
 * intended emphasis. Not fixed by hand-overriding either step's own
 * bundled weight (this project's type scale is deliberately one
 * bundled family+size+weight unit per named step, not freely
 * recombinable) — accepted as-is, since the real size gap (20px vs
 * 14px, ~43% larger) still dominates the visual hierarchy enough that
 * the label reads as the more prominent element regardless of the
 * minor weight difference.
 *
 * BACKGROUND — solid Guard Green Secondary, `on-dark` (the default
 * Ink focus ring is only ~3.06:1 on this fill, too thin — same
 * reasoning already documented for the header info bar/Hero's text
 * panel). White text throughout. Contrast RESTATED for both text
 * roles, RE-CHECKED after the size reduction above rather than
 * assumed to still qualify for the same WCAG threshold it did before:
 * white (L=1.0) vs Guard Green Secondary (L≈0.115) is the same
 * ~6.36:1 colour-pair contrast regardless of size, BUT the size
 * reduction actually changed which threshold applies — the ORIGINAL
 * 28px label cleared WCAG's "large text" bar (≥24px, needs only 3:1);
 * the NEW 20px/400-weight label does NOT qualify as large text
 * (needs ≥24px normal, or ≥18.66px at 700+ weight — 20px/400 clears
 * neither), so it now needs the full 4.5:1 normal-text floor, same as
 * the 14px body always did. 6.36:1 still clears 4.5:1 with real
 * margin for both, so nothing regressed — but the MARGIN shrank for
 * the label specifically, and re-deriving this rather than assuming
 * the old "large text" classification still held is exactly the kind
 * of thing that's easy to get wrong by carrying a number forward
 * without re-checking its own precondition.
 *
 * DIVIDER — a new `tone="paper-strong"` variant added to
 * `Divider.astro` in a previous pass, specifically for this fill (see
 * that component's own comment for the 35%-vs-60%-opacity contrast
 * math). A REAL BUG in how it was wired up here was found and fixed
 * in this pass, not just a contrast/visibility tuning issue: the
 * divider wrapper used a plain `display:block` display value at the
 * `sm:` breakpoint (not flex) — and `Divider`'s own vertical variant
 * relies on `self-stretch` (`align-self:stretch`) to fill whatever
 * height its container settles at. `align-self` only has any effect
 * when the element's IMMEDIATE parent is a flex or grid container —
 * a plain `display:block` wrapper gives it nothing to stretch
 * against, so the divider (an empty div with no content and no
 * explicit height) rendered at its own natural `height:auto`, which
 * for an empty block is 0px — genuinely invisible, not merely
 * low-contrast. This is a rendering/layout defect that no amount of
 * compiled-CSS-class or compiled-HTML-string inspection could have
 * caught (both correctly showed the class was present and compiled to
 * the right colour/opacity rule — the bug was purely in what the
 * layout actually DID with it, only visible in a real render). Fixed
 * by changing the wrapper to `sm:flex` — now a real flex container in
 * its own right, so its child's `self-stretch` has something to
 * stretch against, and the wrapper itself is already being stretched
 * to the full row height by the OUTER row's own `sm:items-stretch`.
 * Re-verified this time via an actual rendered check (a static HTML
 * harness built from the real compiled output, viewed directly), not
 * compiled-artifact inspection alone.
 *
 * A divider between every pair of columns at every breakpoint now —
 * vertical (`Divider`'s `self-stretch` variant) on `sm:`+, horizontal
 * (`Divider`'s plain `<hr>` variant, no equivalent gotcha since a
 * block-level `<hr>` doesn't depend on its parent's display type) on
 * mobile, per explicit follow-up instruction. Both share the same
 * `tone="paper-strong"` colour/opacity. Spacing between stacked mobile
 * items now comes entirely from the horizontal divider's own `my-8`
 * margin, not a flex `gap` — the outer row's `gap-*` was dropped
 * (down to `gap-0`, matching `sm:gap-0`'s existing value) so mobile
 * and desktop share the same "spacing comes from the divider's own
 * margin, not the container" mechanism, rather than mixing a flex gap
 * AND a divider margin and risking doubled-up spacing. This reverses
 * the previous pass's own "gap-only, no divider" mobile treatment
 * (which had matched the very first version of this component) — not
 * a case of that earlier reasoning being wrong, just superseded by a
 * later, more specific instruction.
 *
 * ICONS — plain, no colour-fill badge behind them (removing the
 * previous pass's solid-circle treatment entirely). `size-9` (36px),
 * `stroke-width="1.5"` — a real "medium" step between the original
 * bare-line weight (32px at 1.25, felt thin) and the badge-context
 * weight from the last pass (40px icon inside a 64px circle, tuned
 * for a small enclosed shape rather than a plain mark on an open
 * fill). Concepts reconsidered against the NEW copy, not reused
 * blind: Credential (SIA, unchanged shape/concept — still the right
 * fit) stays; Calendar and Support are both removed outright (their
 * captions, "bespoke shift patterns" and "24/7 phone... support," no
 * longer exist) and replaced with Clock (`src/icons/stats/Clock
 * .astro` — a plain two-handed clock face, fitting the new "24/7"
 * copy's emphasis on continuous COVERAGE rather than "call us"
 * support specifically) and Growth (`src/icons/stats/Growth.astro` —
 * a rising trend-line-and-arrow, fitting "Since 2023" + "rapidly
 * expanding," chosen over a map pin or a flag shape for the reasons
 * documented in that icon's own comment). None are shields or
 * checkmarks. All three rasterised and visually inspected — plain,
 * white, on the real Guard Green Secondary fill, at the actual
 * deployed 36px size and a magnified 220px size, individually and as
 * a row — before shipping; no redraw was needed this time (unlike the
 * very first pass, which did have to redraw one icon after this exact
 * check caught it reading ambiguously).
 *
 * MOTION — unchanged mechanism from the previous pass: `data-reveal`,
 * read by `initScrollReveal()` (`src/lib/scrollReveal.ts`, wired into
 * `index.astro` since the section-redesign PR that introduced it) —
 * a genuine scroll trigger, since this section sits below the fold
 * once the Hero's own height is accounted for. `prefers-reduced-
 * motion` is handled inside `scrollReveal.ts` itself.
 */
const FACTS = [
  {
    label: "24/7",
    body: "Providing reliable security cover 24 hours a day, seven days a week.",
    Icon: Clock,
  },
  {
    label: "SIA",
    body: "Supplying highly trained, SIA-licensed, and fully vetted professional officers you can trust.",
    Icon: Credential,
  },
  {
    label: "Since 2023",
    body: "Born in the North and rapidly expanding our trusted security services across the UK.",
    Icon: Growth,
  },
];
---

<section class="on-dark bg-guard-green-secondary">
  <div class="mx-auto max-w-7xl px-gutter py-16 md:px-12">
    <div class="flex flex-col gap-0 sm:flex-row sm:items-stretch sm:gap-0">
      {
        FACTS.map(({ label, body, Icon }, i) => (
          <>
            {i > 0 && (
              <>
                <div class="sm:hidden">
                  <Divider orientation="horizontal" tone="paper-strong" class="my-8" />
                </div>
                <div class="hidden shrink-0 sm:flex">
                  <Divider orientation="vertical" tone="paper-strong" class="mx-8" />
                </div>
              </>
            )}
            <div data-reveal class="flex flex-1 flex-col items-center text-center sm:items-start sm:text-left">
              <Icon class="text-paper mb-4 size-9" />
              <h3 class="text-body-lg text-paper mb-2">{label}</h3>
              <p class="text-caption text-paper max-w-xs">{body}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
