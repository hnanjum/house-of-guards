---
import Credential from "../../icons/stats/Credential.astro";
import Calendar from "../../icons/stats/Calendar.astro";
import Support from "../../icons/stats/Support.astro";

/**
 * Second redesign of the same three facts (unchanged copy throughout
 * all versions) — this pass adds real visual weight to the icons and
 * fixes a real density problem the previous version had, per direct
 * feedback.
 *
 * ALIGNMENT — INTENTIONAL THIRD EXCEPTION, not an oversight. This
 * project's hard rule (CLAUDE.md) restricts centred alignment to
 * exactly two sanctioned places sitewide (MissionBand's pull-quote,
 * ClosingCta's final line) — the PREVIOUS version of this component
 * deliberately kept StatStrip left-aligned specifically to avoid
 * introducing a third exception without being asked. This pass DOES
 * introduce that third exception, per explicit direct instruction,
 * not a reversal of that earlier reasoning on its own. CLAUDE.md's
 * own hard-rule bullet has been updated in the same PR to say "three"
 * and name StatStrip, so this isn't a case where the code and the
 * project's own rules document disagree — a future pass reading
 * either should find the same answer. Do not "fix" this back to
 * left-aligned assuming it was missed; it wasn't.
 *
 * ICON BADGES — the previous version's bare 32px line icons read as
 * too thin/sparse to feel premium. Each icon now sits inside a
 * solid `size-16` (64px) Guard Green Secondary circle, `size-10`
 * (40px) white icon centred inside it (a 12px margin on every side —
 * matches the exact proportions verified below, not a fresh guess).
 * White-on-Guard-Green-Secondary is this project's own already-
 * established safe pairing (Button.astro's `primary` fill, the header
 * info bar, MissionBand's fallback fill) — RESTATED here rather than
 * assumed to still hold now that it's an icon rather than text: white
 * (L=1.0) vs Guard Green Secondary (L≈0.115) → (1.0+0.05)/(0.115+0.05)
 * ≈ 6.36:1 (AAA-adjacent, same figure as every other white-on-this-
 * fill pairing in the project, since it's the same two colours being
 * compared regardless of what's drawn on top).
 *
 * The bare-line icons (Credential/Calendar/Support, all in
 * `src/icons/stats/`) were kept as outline glyphs rather than redrawn
 * as solid/filled shapes — checked, not assumed, per the explicit
 * fallback in the brief: rasterised the badge treatment at the actual
 * deployed 64px size and a magnified 240px size, individually and as
 * a row, and the existing linework translated cleanly once its own
 * `stroke-width` was bumped from `1.25` to `2` (each icon's own file
 * has this noted — they have no other usage site, so the weight was
 * changed at the source rather than kept thin for a bare-line context
 * that no longer exists anywhere in this codebase). No redraw was
 * needed; see the PR description for the rendered check.
 *
 * DENSITY / SECTION SIZING — the previous version's real problem was
 * the OUTER container (`py-24`, 96px top+bottom) around a genuinely
 * small amount of content, not the icons alone — fixing icon weight
 * without touching this would have left the same oversized empty box.
 * Cut to `py-10` (40px). Badge→caption gap cut from a 16px margin to
 * `mb-2` (8px) so each icon and its caption read as one attached unit
 * rather than two nearby elements. Column gap (`gap-y`) tightened
 * 10→6. Real box-model math, not eyeballed: badge (64px) + gap (8px)
 * + the longest caption at 2 lines (`text-body`, 17px/1.6 line-height
 * ≈ 27.2px/line × 2 ≈ 54.4px, the realistic wrap for "Every officer
 * SIA-licensed & first-aid trained" inside a ~370px column at desktop
 * `max-w-7xl` width) ≈ 126px of real content, plus 80px of padding
 * (40 top + 40 bottom) ≈ 206px total section height — padding is now
 * well under half the section's own height, not the majority of it
 * the way the previous `py-24` version's box-model worked out to.
 *
 * BACKGROUND — `bg-surface-alt` (`#f5f5f5`), unchanged from the
 * previous redesign; see its own token comment in global.css for why
 * Hairline wasn't reused and the real WCAG numbers against it (Ink
 * ~17.8:1, Guard Green Secondary bare-mark ~5.84:1 — not used for
 * bare-mark contact here any more now that the icon sits on its own
 * opaque badge fill instead of directly on this surface). No
 * `on-dark` — this is a light fill, the default Ink focus ring is
 * already safe on it.
 *
 * BREAKPOINT / MOTION / DIVIDER-REMOVAL — unchanged from the previous
 * redesign, see git history for that reasoning: `sm:` matches this
 * component's own prior convention; `data-reveal` is read by
 * `initScrollReveal()` (`src/lib/scrollReveal.ts`, called from
 * `index.astro`); the vertical Divider between facts stays removed.
 */
const FACTS = [
  { text: "Every officer SIA-licensed & first-aid trained", Icon: Credential },
  { text: "Bespoke shift patterns, not fixed packages", Icon: Calendar },
  { text: "24/7 phone and on-shift officer support", Icon: Support },
];
---

<section class="bg-surface-alt">
  <div class="mx-auto max-w-7xl px-gutter py-10 md:px-12">
    <div class="grid grid-cols-1 gap-x-8 gap-y-6 sm:grid-cols-3">
      {
        FACTS.map(({ text, Icon }) => (
          <div data-reveal class="flex flex-col items-center text-center">
            <div class="bg-guard-green-secondary mb-2 flex size-16 items-center justify-center rounded-full">
              <Icon class="text-paper size-10" />
            </div>
            <p class="text-body text-ink">{text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
