---
import Divider from "../ui/Divider.astro";

/**
 * One of the two required bold accent sections — now Guard Yellow.
 * Ink text (~11.06:1, AAA — an even bigger margin than the previous
 * accent, Guard Olive, managed at ~6.24:1), not white (~1.76:1, fails
 * badly) — see the design-token comment in global.css. Translucent Ink
 * dividers between the three facts: the pale Hairline grey would
 * nearly disappear against a bright colour fill this light, and a
 * translucent white would be even less visible here than it already
 * was against Olive.
 *
 * No `on-dark`: Guard Yellow isn't dark enough to need the white-ring
 * focus swap — the default Ink ring already measures ~11.06:1 against
 * it, comfortably clear of the 3:1 floor on its own (a white ring here
 * would actually be far worse, ~1.76:1).
 */
const FACTS = [
  "Every officer SIA-licensed & first-aid trained",
  "Bespoke shift patterns, not fixed packages",
  "24/7 phone and on-shift officer support",
];
---

<section class="bg-guard-yellow">
  <div class="mx-auto max-w-7xl px-gutter py-10 md:px-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-stretch sm:gap-0">
      {
        FACTS.map((fact, i) => (
          <>
            {i > 0 && (
              <div data-stat-divider class="hidden shrink-0 sm:block">
                <Divider orientation="vertical" tone="ink" class="mx-8" />
              </div>
            )}
            <div data-stat-text class="flex-1">
              <p class="text-body text-ink">{fact}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
