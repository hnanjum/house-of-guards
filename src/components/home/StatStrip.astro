---
import Divider from "../ui/Divider.astro";

/**
 * One of the two required bold accent sections — now Guard Green
 * Secondary. White/Paper text (~6.36:1, AA), not Ink (~3.06:1, fails
 * AA normal-text) — the inverse pairing of the previous two accents
 * this section has used (Guard Yellow, Guard Olive), both of which
 * needed Ink instead — see the design-token comment in global.css.
 * Translucent Paper (white) dividers between the three facts, not Ink
 * — this fill is dark enough that a pale/translucent Ink line would
 * be hard to see, the same reasoning `tone="paper"` already documents
 * for a Guard Green Deep / Footer Grey background; a translucent Ink
 * divider was only ever right for the two prior, much lighter accents.
 *
 * Carries `on-dark` now — a real change, not a restatement. Ink ring
 * on this fill is only ~3.06:1 (barely above the 3:1 floor, too thin
 * to trust); white ring on it is ~6.36:1, a real margin. Both previous
 * accents here (Yellow ~11.06:1, Olive ~6.24:1) kept the default Ink
 * ring comfortably safe on their own and explicitly did NOT carry
 * `on-dark` — that reasoning doesn't transfer to this darker fill.
 */
const FACTS = [
  "Every officer SIA-licensed & first-aid trained",
  "Bespoke shift patterns, not fixed packages",
  "24/7 phone and on-shift officer support",
];
---

<section class="on-dark bg-guard-green-secondary">
  <div class="mx-auto max-w-7xl px-gutter py-10 md:px-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-stretch sm:gap-0">
      {
        FACTS.map((fact, i) => (
          <>
            {i > 0 && (
              <div data-stat-divider class="hidden shrink-0 sm:block">
                <Divider orientation="vertical" tone="paper" class="mx-8" />
              </div>
            )}
            <div data-stat-text class="flex-1">
              <p class="text-body text-paper">{fact}</p>
            </div>
          </>
        ))
      }
    </div>
  </div>
</section>
