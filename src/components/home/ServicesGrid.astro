---
import SectionHeading from "../ui/SectionHeading.astro";
import CorporateSecurity from "../../icons/services/CorporateSecurity.astro";
import CloseProtection from "../../icons/services/CloseProtection.astro";
import CctvMonitoring from "../../icons/services/CctvMonitoring.astro";
import MannedGuarding from "../../icons/services/MannedGuarding.astro";
import ConstructionSecurity from "../../icons/services/ConstructionSecurity.astro";
import OvernightSecurity from "../../icons/services/OvernightSecurity.astro";

/**
 * "Services We Offer" — replaces `ServicesIndex.astro`'s numbered
 * accordion outright as the homepage's services section, per explicit
 * instruction. `ServicesIndex.astro` itself has been deleted, not left
 * unused (see its own removal in this commit's diff) — nothing else in
 * the codebase referenced it.
 *
 * THIS IS A DELIBERATE, EXPLICIT EXCEPTION TO A STANDING HARD RULE —
 * READ BEFORE TOUCHING THIS SECTION AGAIN. CLAUDE.md's own hard rules
 * state "No identical bordered/shadowed card grids with no real
 * hierarchy… There is no card-grid component in this codebase and
 * none should be added for services/sectors-shaped content." This
 * section IS a card grid for services-shaped content, built on
 * direct, explicit, detailed instruction (exact 3×2 layout, exact
 * alternating fill colours, exact per-card content) — not a case of
 * that rule being quietly ignored or forgotten. It also isn't a
 * literal violation of the rule's own stated target: every card here
 * is a SOLID colour fill with no border and no shadow at all (the
 * rule specifically named "bordered/shadowed" grids), and each card
 * carries real icon+heading+body hierarchy, not identical repeated
 * content. CLAUDE.md's hard-rules section itself has been updated in
 * this same commit to name this section as a third sanctioned
 * card-shaped treatment alongside `SectorsStrip.astro`'s photo grid —
 * don't read the original rule text in isolation and assume this
 * component is a mistake sitting on top of it.
 *
 * LAYOUT — `grid-cols-1 sm:grid-cols-2 lg:grid-cols-3` (matches
 * `SectorsStrip.astro`'s own graduated-breakpoint convention for a
 * six-item grid, rather than jumping straight from 1 to 3 columns) —
 * resolves to the requested "3 columns / 2 rows" shape at `lg:`+ and a
 * genuine single-column stack on mobile. No `gap` between cells and no
 * dividers — the cards sit truly edge-to-edge (like `SectorsStrip`'s
 * own edge-to-edge photo grid), since the colour change between
 * adjacent cards IS the visual seam here; a gap or hairline would
 * dilute the read rather than reinforce it. CSS Grid's
 * own default `align-items: stretch` equalises every card in a row to
 * the tallest card's height automatically — no fixed/min height was
 * set on any card, so this stays fully content-driven like every
 * other section on the site.
 *
 * FILL ASSIGNMENT — REBUILT for the Electric-Blue/Magenta rebrand, and
 * a genuinely different mechanism from the retired version: the old
 * `index % 2` alternation is gone entirely, replaced by a fixed,
 * PER-SERVICE assignment (a `fill` field on each `SERVICES` entry,
 * plus an `iconAccent` field for the light cards only) given directly
 * by explicit instruction, not derived from card position at all.
 * Don't reintroduce a parity/position-based rule here without a real
 * reason — the six fills below are pinned to specific SERVICE NAMES,
 * not slots, so reordering `SERVICES` would silently break the
 * intended assignment if the fill still came from `index % 2`.
 * Resulting layout (row one: Corporate Security, Close Protection,
 * CCTV Monitoring; row two: Manned Guarding, Construction Site
 * Security, Overnight Security, at `lg:`'s 3-column width): light /
 * Magenta / light, then Electric Blue / light / Electric Blue — a
 * deliberate mixed fill/light pattern, not a strict alternating
 * checkerboard (the old version's own "falls out of the odd column
 * count for free" property doesn't apply to a fixed, name-keyed
 * assignment, and wasn't asked for here).
 *
 * COLOUR + CONTRAST, all three treatments computed independently, not
 * assumed to mirror one another just because two of them share a hue:
 * - ELECTRIC BLUE cards (Manned Guarding, Overnight Security —
 *   `on-dark bg-electric-blue text-paper`) — white text/icon on
 *   Electric Blue, ~5.17:1 (AA, real margin — see global.css's own
 *   Electric Blue token comment for the full derivation, including why
 *   this is LOWER than the retired green fill's own ~6.36:1 despite
 *   both reading as "a dark accent"). `.on-dark` for the focus ring,
 *   same reasoning as StatStrip/the header info bar.
 * - MAGENTA cards (Close Protection — `on-dark bg-magenta text-paper`)
 *   — white text/icon on Magenta, ~7.26:1 (AAA, the strongest fill
 *   pairing in this whole rebrand). `.on-dark` applied defensively
 *   (no card has a focusable element today, matching the same habit
 *   the retired green cards already had).
 * - LIGHT cards (Corporate Security, CCTV Monitoring, Construction
 *   Site Security — `bg-surface-alt text-ink`, no `.on-dark`, the
 *   sitewide default Ink focus ring is already safe here) reuse
 *   `--color-surface-alt` — the token global.css itself already
 *   documents as built for exactly this ("a section background that
 *   needs to read as visually distinct from Paper without becoming a
 *   bold accent band"), not Paper itself, so a light card still reads
 *   as its own distinct card against the section's own white
 *   background, and never two flush together (checked against the
 *   real layout above: every light card in this specific six-service
 *   arrangement sits between two coloured neighbours on every side it
 *   touches, so this isn't load-bearing for THIS layout, but it's the
 *   correct choice regardless of arrangement, not a lucky accident of
 *   this one). Ink text/icon on Surface Alt: ~17.8:1 (AAA, trivial
 *   margin). Each light card's ICON (not its text) carries its own
 *   accent stroke colour, keyed by `iconAccent` — Electric Blue
 *   (Corporate Security) or Magenta (CCTV Monitoring, Construction
 *   Site Security) — checked as the REVERSE pairing (a mid-tone mark
 *   on a light surface, not the fill-on-dark question above): Electric
 *   Blue vs Surface Alt ≈4.74:1, Magenta vs Surface Alt ≈6.66:1, both
 *   clearing the 3:1 WCAG 1.4.11 non-text/graphical-object floor (an
 *   icon isn't running text) with real margin. The retired scoped-only
 *   `--color-services-accent-yellow` token is gone from `global.css`
 *   entirely, not just unreferenced here — confirmed via a full repo
 *   grep before deleting it, matching this project's "retired tokens
 *   are removed outright" convention.
 *
 * The old `services-accent-yellow`/`guard-green-secondary` two-way
 * text-colour switch (`isGreen ? ... : ...`) is now a genuine THREE-way
 * switch (`FILL_CLASS[fill]`, plus a separate `ICON_ACCENT_CLASS`
 * lookup for the light-card icons only) — both keyed directly off each
 * `SERVICES` entry's own `fill`/`iconAccent` fields, so fill and
 * text/icon colour can never drift out of sync the same way the old
 * `isGreen` boolean already guaranteed for its own two-way version.
 *
 * ALIGNMENT — left-aligned card content throughout (`SectionHeading`'s
 * own left-aligned default, `items-start text-left` on every card) —
 * this section is explicitly NOT one of the two sanctioned centred-
 * alignment exceptions (`MissionBand`, `ClosingCta`), matching the
 * hard rule directly.
 *
 * BODY TEXT — went through TWO reductions, not one. First pass (the
 * Electric-Blue/Magenta/Amber rebrand) stepped down exactly one named
 * tier: `text-body` (17px) → `text-caption` (14px), the same "read the
 * current class, step down exactly one tier" discipline already used
 * on Hero and StatStrip. A direct follow-up instruction asked for
 * "quite a bit smaller… not just one more type-scale step down" —
 * `text-caption` → `text-fine` (10px, a NEW ninth step added to the
 * scale specifically for this, see its own comment in `global.css`),
 * since the scale's only other existing smaller step, `text-micro`
 * (12px), is deliberately scoped to "legal/footer only" and would only
 * have been one tier down anyway, not the requested two-tier-or-more
 * drop. Heading size (`text-h3`) and icon size (`size-12`) are
 * UNCHANGED by either pass — only this one paragraph moved.
 *
 * CONTRAST, RE-CHECKED at 10px rather than assumed to still hold from
 * the 14px pairing — the actual colour-pair ratios (white vs Electric
 * Blue/Magenta, Ink vs Surface Alt) are a function of the two COLOURS
 * only and don't change with font size, but which WCAG threshold
 * applies (3:1 "large text" vs 4.5:1 "normal text") does depend on
 * size/weight, and that's the thing that genuinely needed re-deriving,
 * not assuming: WCAG's large-text exemption needs ≥24px at any weight,
 * or ≥18.66px at 700+ weight — 14px/500 never qualified for it, and
 * 10px/500 doesn't either, so this is NOT a threshold crossover (unlike
 * StatStrip's own 28px→20px change, which genuinely did cross out of
 * the large-text exemption) — both sizes were always squarely "normal
 * text," needing the full 4.5:1 floor, both before and after this
 * change. Re-confirmed the three pairings still clear it: white on
 * Electric Blue ~5.17:1, white on Magenta ~7.26:1, Ink on Surface Alt
 * ~17.8:1 — all unchanged from the rebrand's own numbers (colour, not
 * size, drives these) and all still real, comfortable margin above
 * 4.5:1.
 *
 * Worth flagging the same weight quirk StatStrip's own comment already
 * documents for this scale, since it applies again here: `text-fine`
 * (10px) is weight 500, same as `text-caption` was — so this card's
 * body copy is still technically no lighter in weight than the
 * original `text-body` (17px, weight 400), just considerably smaller.
 * Not corrected by hand-overriding the step's own bundled weight (this
 * system's type scale is deliberately one bundled family+size+weight
 * unit per named step, not freely recombinable) — accepted as-is,
 * matching the precedent StatStrip's own comment already set for this
 * identical situation.
 *
 * ICONS — six bespoke SVGs, GEOMETRY UNCHANGED from PR #16 (same six
 * file paths under `src/icons/services/`, same paths inside, same
 * `stroke-width="2"`, same `size-12`/48px — see PR #16's own
 * CLAUDE.md entry for the full rasterise-and-inspect history on the
 * SHAPES themselves, not repeated here since nothing about the shapes
 * changed). ONLY the light cards' icon colour changed (Ink → Electric
 * Blue/Magenta stroke, per `iconAccent` above); coloured-fill cards'
 * icons are unchanged (still `currentColor`, inheriting `text-paper`
 * from the card wrapper, same as before). Deliberately NOT re-run
 * through the mandatory rasterise-and-look process this codebase
 * requires before shipping new icon GEOMETRY — that check exists to
 * catch an ambiguous/illegible SHAPE, and no shape changed here, only
 * a stroke colour already verified against its new background via the
 * WCAG maths above. Re-run the rasterise check if this is ever touched
 * again in a way that changes geometry, not for a colour-only edit
 * like this one. Colour inherits via `currentColor` from each card's
 * own wrapper (`text-paper` for a filled card, `text-ink` for a light
 * card's heading/body) OR, for a light card's icon specifically, an
 * explicit accent class applied directly to the `<Icon>` element
 * itself, overriding the wrapper's own `text-ink` for that one child
 * — the icon and the heading/body need genuinely different colours on
 * a light card, which the old two-way (green/yellow) version never had
 * to handle. No colour prop is threaded through the icon components
 * themselves either way, same as before — the override is a plain
 * Tailwind class on the rendered `<Icon class={...} />` call.
 *
 * MOTION — `data-services-reveal` + `initServicesGridReveal()`
 * (`src/lib/servicesGridReveal.ts`, wired into `index.astro`'s own
 * `astro:page-load` handler alongside the Hero/StatStrip entries
 * already there) — a genuine scroll-triggered scale-up-from-0.85 +
 * settle-from-a-few-degrees-tilt entrance, staggered per card, calm
 * `power3.out` easing throughout (no bounce/elastic). See that
 * module's own comment for the full mechanism and the reduced-motion
 * fallback (a plain, instant full-opacity/flat/full-scale state, no
 * animation, matching every other entry point on this site).
 */
type Fill = "electric-blue" | "magenta" | "light";
type IconAccent = "electric-blue" | "magenta";

const SERVICES: { name: string; body: string; Icon: typeof CorporateSecurity; fill: Fill; iconAccent?: IconAccent }[] =
  [
    {
      name: "Corporate Security",
      body: "Front-of-house officers, access control and CCTV oversight that reflect the standards of your organisation.",
      Icon: CorporateSecurity,
      fill: "light",
      iconAccent: "electric-blue",
    },
    {
      name: "Close Protection",
      body: "Discreet personal protection for individuals, families and visiting guests, at home and in transit.",
      Icon: CloseProtection,
      fill: "magenta",
    },
    {
      name: "CCTV Monitoring",
      body: "Round-the-clock camera monitoring with rapid escalation the moment something looks wrong.",
      Icon: CctvMonitoring,
      fill: "light",
      iconAccent: "magenta",
    },
    {
      name: "Manned Guarding",
      body: "Highly trained, SIA licensed guards providing a visible presence from crowd control to mobile patrol.",
      Icon: MannedGuarding,
      fill: "electric-blue",
    },
    {
      name: "Construction Site Security",
      body: "Protecting plant, materials and part-built structures on sites that are a magnet for thieves.",
      Icon: ConstructionSecurity,
      fill: "light",
      iconAccent: "magenta",
    },
    {
      name: "Overnight Security",
      body: "Dedicated night cover for premises that are most vulnerable once the working day ends.",
      Icon: OvernightSecurity,
      fill: "electric-blue",
    },
  ];

// Keyed off each SERVICES entry's own `fill`, never derived from index —
// see this file's own FILL ASSIGNMENT comment above for why.
const FILL_CLASS: Record<Fill, string> = {
  "electric-blue": "on-dark bg-electric-blue text-paper",
  magenta: "on-dark bg-magenta text-paper",
  light: "bg-surface-alt text-ink",
};

// Only consulted for `fill: "light"` cards — a filled card's icon
// inherits `text-paper` from the card wrapper above and needs no
// override.
const ICON_ACCENT_CLASS: Record<IconAccent, string> = {
  "electric-blue": "text-electric-blue",
  magenta: "text-magenta",
};
---

<section class="bg-paper">
  <div class="mx-auto max-w-7xl px-gutter py-24 md:px-12">
    <SectionHeading level="h2">Services We Offer</SectionHeading>

    <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
      {
        SERVICES.map(({ name, body, Icon, fill, iconAccent }) => (
          <div data-services-reveal class:list={["flex flex-col items-start p-8 text-left sm:p-10", FILL_CLASS[fill]]}>
            <Icon class:list={["mb-6 size-12", fill === "light" && iconAccent && ICON_ACCENT_CLASS[iconAccent]]} />
            <h3 class="text-h3 mb-3">{name}</h3>
            <p class="text-fine">{body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
