---
/**
 * A single header/footer nav link. Sentence case, Caption scale (14px)
 * — deliberately quiet rather than a large, loud nav bar. No icon, no
 * arrow.
 *
 * `tone="ink"` (default) — for a link sitting on a Paper background.
 * Text is always Ink (never the accent colour for running text, on
 * general principle — this link's own text-colour choice is
 * independent of whichever accent is current). Active/hover state is
 * a 2px Guard Green Secondary underline instead — a non-text accent.
 * Genuinely compliant this time, not just kept-despite-a-gap: this
 * fill's own bare-mark-on-Paper contrast is ~6.36:1 (see global.css's
 * token comment for why that's the same number as the white-on-fill
 * pairing, not a coincidence) — clears the FULL 4.5:1 normal-text
 * floor, not just the lenient 3:1 non-text one. Both the previous
 * accents this underline has used (Guard Yellow ~1.76:1, Guard Olive
 * ~3.11:1) fell short of that; this one doesn't. A transparent
 * underline sits there at rest so nothing shifts layout when it
 * appears.
 *
 * `tone="paper"` — for a link sitting on a Footer Grey / Guard Green
 * Deep background, where dark text would be nearly invisible. White
 * text instead; hover/current state is communicated by opacity, not a
 * hue shift, since there's no second colour that reads clearly on
 * every dark surface this can appear on.
 */
interface Props {
  href: string;
  tone?: "ink" | "paper";
  class?: string;
}

const { href, tone = "ink", class: className } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const linkPath = href.replace(/\/$/, "") || "/";
const isActive = currentPath === linkPath;

const toneClasses = {
  ink: isActive
    ? "text-ink border-guard-green-secondary"
    : "text-ink border-transparent hover:border-guard-green-secondary",
  paper: isActive ? "text-paper border-transparent" : "text-paper hover:text-paper/70 border-transparent",
};
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "text-caption border-b-2 pb-0.5 transition-colors duration-200 ease-out",
    toneClasses[tone],
    className,
  ]}
>
  <slot />
</a>
