---
/**
 * A single header/footer nav link. Sentence case, Caption scale (14px)
 * — deliberately quiet rather than a large, loud nav bar. No icon, no
 * arrow.
 *
 * `tone="ink"` (default) — for a link sitting on a Paper background.
 * Text is always Ink (never the accent colour for running text, on
 * general principle — this link's own text-colour choice is
 * independent of whichever accent is current). Active/hover state is
 * a 2px Amber underline instead — a non-text accent, matching the
 * site's own button/CTA colour for consistency (per explicit
 * instruction) rather than reusing whichever block colour a given
 * section happens to be filled with.
 *
 * KNOWN, REVIEWED, ACCEPTED CONTRAST GAP — not something to silently
 * assume is compliant, but also not open for an unprompted "fix".
 * Amber's bare-mark-on-Paper contrast is ~2.15:1 (see global.css's own
 * Amber token comment for the full derivation) — this FAILS the 3:1
 * WCAG 1.4.11 non-text/UI floor outright, not a thin-margin pass.
 * Every accent this underline has used before this one was checked and
 * passed (Guard Green Secondary ~6.36:1, clearing even the full 4.5:1
 * text floor; Guard Yellow ~1.76:1 and Guard Olive ~3.11:1 both failed
 * too, for what it's worth, so this isn't unprecedented for this exact
 * underline — but it IS a real regression from the immediately-
 * previous, fully-compliant pairing). Shipped on direct instruction to
 * use Amber here "to stay consistent with buttons everywhere else" —
 * flagged plainly in PR #17's own description, and **the user reviewed
 * this exact ~2.15:1 number afterward and explicitly confirmed keeping
 * it as shipped.** This is now a settled, accepted tradeoff, not an
 * open item — don't "fix" it (a darker amber reserved for bare marks
 * only, or a non-colour affordance like weight/thickness) without a
 * fresh, explicit ask to revisit it. A transparent underline sits
 * there at rest so nothing shifts layout when it appears.
 *
 * `tone="paper"` — for a link sitting on a Footer Grey / Guard Green
 * Deep background, where dark text would be nearly invisible. White
 * text instead; hover/current state is communicated by opacity, not a
 * hue shift, since there's no second colour that reads clearly on
 * every dark surface this can appear on.
 */
interface Props {
  href: string;
  tone?: "ink" | "paper";
  class?: string;
}

const { href, tone = "ink", class: className } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const linkPath = href.replace(/\/$/, "") || "/";
const isActive = currentPath === linkPath;

const toneClasses = {
  ink: isActive ? "text-ink border-amber" : "text-ink border-transparent hover:border-amber",
  paper: isActive ? "text-paper border-transparent" : "text-paper hover:text-paper/70 border-transparent",
};
---

<a
  href={href}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    "text-caption border-b-2 pb-0.5 transition-colors duration-200 ease-out",
    toneClasses[tone],
    className,
  ]}
>
  <slot />
</a>
