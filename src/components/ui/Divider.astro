---
/**
 * A single hairline rule — the connective tissue used across the whole
 * site instead of borders/shadows around boxes.
 *
 * `tone="hairline"` (default) — the neutral grey token, for use on
 * Paper backgrounds.
 *
 * `tone="paper"` — a translucent white line at 35% opacity, for use on
 * a Guard Green Deep / Footer Grey background, where the grey Hairline
 * token would barely register. This is white at reduced opacity, not
 * a new colour token.
 *
 * `tone="paper-strong"` — a translucent white line, for a bold
 * accent-fill background specifically (StatStrip only — the sole real
 * call site). RECALIBRATED for the Electric-Blue rebrand, not carried
 * forward unchanged: this was originally 60% opacity, tuned against
 * the retired Guard Green Secondary fill (L≈0.115) — checked fresh
 * against Electric Blue (L≈0.1531, meaningfully LIGHTER despite both
 * reading as "a dark saturated accent" at a glance) rather than
 * assumed to still clear the same floor, and it doesn't: at 60%
 * opacity the line-to-fill contrast on Electric Blue is only ~2.85:1
 * — UNDER the 3:1 WCAG 1.4.11 non-text/UI-component floor, a real
 * regression from the old ~3.39:1 pass. Opacity is now **70%**,
 * clearing that floor with real margin again, ~3.35:1 — computed via
 * the same relative-luminance math as every other pairing in this
 * project, not guessed. Since this tone has exactly one real call
 * site (StatStrip, confirmed via a repo grep before changing the
 * shared value rather than forking a second tone) it was safe to
 * recalibrate the token in place instead of adding a parallel
 * `paper-strong-blue` variant — re-verify this same 70% value again,
 * the same way, before ever reusing `paper-strong` against a THIRD
 * fill.
 *
 * `tone="ink"` — a translucent Ink line at 25% opacity. Currently
 * UNUSED anywhere in this codebase (kept as an available option, not
 * dead-code-removed) — originally calibrated for a StatStrip version
 * filled with the long-retired Guard Olive accent (see CLAUDE.md's
 * "Retired tokens" note); that specific pairing no longer exists
 * anywhere on the site. Re-verify the actual math against whatever
 * fill it's used on before reaching for this again, the same way
 * `tone="paper-strong"` was checked fresh above rather than assumed.
 */
interface Props {
  orientation?: "horizontal" | "vertical";
  tone?: "hairline" | "paper" | "paper-strong" | "ink";
  class?: string;
}

const { orientation = "horizontal", tone = "hairline", class: className } = Astro.props;

const colorClass = {
  hairline: { border: "border-hairline", bg: "bg-hairline" },
  paper: { border: "border-paper/35", bg: "bg-paper/35" },
  "paper-strong": { border: "border-paper/70", bg: "bg-paper/70" },
  ink: { border: "border-ink/25", bg: "bg-ink/25" },
}[tone];
---

{
  orientation === "horizontal" ? (
    <hr class:list={["border-0 border-t", colorClass.border, className]} />
  ) : (
    <div
      class:list={["w-px self-stretch", colorClass.bg, className]}
      role="separator"
      aria-orientation="vertical"
    />
  )
}
