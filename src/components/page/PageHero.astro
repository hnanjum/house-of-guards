---
import { Image } from "astro:assets";

/**
 * Shared opening section for interior pages. Caption, serif headline, short
 * Amber rule, lead line, an optional actions slot, and an optional photo on
 * the right.
 *
 * TONE — owner instruction (2026-10-10): the Services, sector and Careers
 * heroes must NOT be black. They use tone="paper" (the default): Paper
 * background, photo with an offset Surface Alt block behind it. tone="ink"
 * is the About-style black masthead (photo in a thin Paper/15 frame), still
 * used by the Get a Quote page. Black is fine for bands further down a page.
 *
 * Mobile centring (standing owner rule): text centres until the layout
 * splits into two columns at lg, then left-aligns.
 *
 * Contrast — paper: Ink on Paper ~19.4:1, Stone caption/lead ~4.6:1 (14px+).
 * ink: Paper on Ink ~19.4:1, Paper/70 ~9.6:1, .on-dark ring on Ink. Amber is
 * a bare decorative rule in both, never text.
 */
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  imagePosition?: string;
  tone?: "paper" | "ink";
}

const { eyebrow, title, lead, image, imageAlt = "", imagePosition = "object-center", tone = "paper" } = Astro.props;
const hasActions = Astro.slots.has("default");
const dark = tone === "ink";
---

<section class={dark ? "on-dark bg-ink text-paper" : "bg-paper text-ink"}>
  <div
    class:list={[
      "mx-auto grid max-w-7xl grid-cols-1 items-center gap-14 px-gutter pt-16 pb-20 md:px-12 md:pt-24 md:pb-28",
      image && "lg:grid-cols-12 lg:gap-12",
    ]}
  >
    <div class:list={["text-center lg:text-left", image && "lg:col-span-6"]}>
      <p class:list={["text-caption", dark ? "text-paper/70" : "text-stone"]}>{eyebrow}</p>
      <h1 class="text-h1 sm:text-display mx-auto mt-5 max-w-2xl lg:mx-0">{title}</h1>
      <span aria-hidden="true" class="mx-auto mt-8 block h-0.5 w-12 bg-amber lg:mx-0"></span>
      {
        lead && (
          <p class:list={["text-body-lg mx-auto mt-8 max-w-xl lg:mx-0", dark ? "text-paper/70" : "text-stone"]}>
            {lead}
          </p>
        )
      }
      {
        hasActions && (
          <div class="mt-10 flex flex-wrap items-center justify-center gap-4 lg:justify-start">
            <slot />
          </div>
        )
      }
    </div>

    {
      image && (
        <div class="relative mx-auto w-full max-w-xl lg:col-span-6 lg:max-w-none">
          {!dark && (
            <div
              aria-hidden="true"
              class="bg-surface-alt absolute -right-3 -bottom-3 hidden h-full w-full sm:block md:-right-5 md:-bottom-5"
            />
          )}
          <div class:list={["relative", dark && "border border-paper/15 p-3"]}>
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={image}
                alt={imageAlt}
                widths={[480, 768, 1024, 1400]}
                sizes="(min-width: 1024px) 45vw, 100vw"
                class:list={["h-full w-full object-cover", imagePosition]}
                format="webp"
                quality={82}
                loading="eager"
              />
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
