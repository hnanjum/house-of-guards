---
import NavLink from "./ui/NavLink.astro";
import Button from "./ui/Button.astro";
import Phone from "../icons/Phone.astro";
import Location from "../icons/Location.astro";
import NavDrawer from "./NavDrawer.tsx";

/**
 * Site header. Two bars: a solid Guard Olive Bright info bar, then a
 * Paper/white sticky main nav — a deliberate departure from the old
 * single solid Guard Green fill (see the design-system note in
 * global.css on why the shared Guard Olive token can't carry that
 * role on its own: white text on it is only ~3.11:1, well under AA).
 *
 * 1. Info bar — solid Guard Olive Bright fill, Ink text/icons (~8.21:1,
 *    AAA — see the token's own comment in global.css for why this is a
 *    genuinely different, lighter shade from the shared Guard Olive
 *    token used everywhere else, not the same colour restated).
 *    Superseded, kept only as history: an earlier pass here used a
 *    Paper background with Stone text (~4.6:1, AA) — that reasoning
 *    doesn't apply any more now the fill itself is Olive Bright, not
 *    Paper.
 *    Always a single row (`flex`, never stacks) — phone + address sit
 *    on one line at every width, centered on mobile (`justify-center`,
 *    where there's no wordmark/nav alongside it to align against) and
 *    left-aligned from `sm:` up (`sm:justify-start`, matching the nav
 *    bar's own left edge below it). Real per-glyph width measurements
 *    against the actual Montserrat font file (not eyeballed) confirmed
 *    both strings already fit on one line at 375/390px at the existing
 *    icon/text sizes with real margin to spare (~28–43px slack even at
 *    a comfortable `gap-4` between them) — no further shrink needed;
 *    text/icon sizing is unchanged from before. Small line icons
 *    matching the existing icon set's stroke weight. Not sticky
 *    (scrolls away with the page) — a persistent presence here would
 *    eat vertical space on every scroll position for content that only
 *    matters at the top of the page.
 *    No divider below it any more (was a plain hairline `<hr>`) — with
 *    a solid Olive-Bright fill giving way to the Paper nav bar below,
 *    the colour change itself is the boundary, same reasoning the
 *    sticky nav bar's own `border-b` comment below already establishes
 *    for the opposite case (no colour change = a line is needed; a
 *    real colour change = it isn't).
 * 2. Main nav bar — wordmark left, a single (links + CTA) cluster
 *    right, sticky at the top on scroll. The links and the CTA are
 *    grouped into one flex block rather than being 3 separate
 *    `justify-between` children — with only 3 unevenly-sized items
 *    (wordmark / nav / CTA), `justify-between` was distributing the
 *    row's leftover space into two large, uncontrolled gaps around the
 *    nav block, which is what read as "sparse." Now there are only 2
 *    top-level items (wordmark, cluster), so the whole row's leftover
 *    space collapses into one gap between them, and the internal
 *    link-to-link and links-to-CTA gaps are both a fixed, tightened
 *    `gap-6` instead of whatever `justify-between` happened to leave.
 *    `border-b border-hairline` here is a real, needed addition (not
 *    decorative): the old header's colour boundary against the Paper
 *    page below is gone now that both are Paper — without a line, a
 *    pinned sticky bar would visually vanish into whatever scrolls
 *    underneath it.
 *    Row vertical padding is `py-2.5`, not the more generous `py-4` an
 *    earlier pass used — diagnosed via the actual box model (Tailwind's
 *    spacing scale is deterministic, no live render needed to compute
 *    it) before touching anything, not guessed: text-caption's own
 *    line-height (1.5) gives NavLink a ~25px box (21px line + the
 *    link's own 2px underline-gap padding + 2px border), while the
 *    Button — same 21px text line-height, but its own `py-2.5` padding
 *    — is ~41px tall. `items-center` centers everything in the row on
 *    the TALLEST item, which is the Button (or, below `lg`, the 44px
 *    hamburger trigger) — so the row's own `py-*` is the ONLY visible
 *    gap around it either way. At the old `py-4` (16px/side) that was
 *    ~39% of the Button's own height per side, and — the actual
 *    reported symptom — visibly obvious specifically around the
 *    Button's own hard-edged fill, where a plain NavLink has no
 *    rendered box edge for the same padding to read against at all.
 *    `py-2.5` (10px/side, ~24% of the Button's height) keeps real
 *    breathing room without the "floating in a frame" look. This was a
 *    padding-amount problem, not a misalignment one — `items-center`
 *    itself was already correct, and growing the Button back up would
 *    have undone the earlier "make it smaller" pass, so neither of
 *    those was the fix.
 *
 * Neither bar carries `on-dark` any more — Paper backgrounds use the
 * default Ink focus ring, which is already the safe choice here.
 *
 * `lg` (1024px) is the nav↔hamburger breakpoint, same as before. Read
 * literally, "desktop/tablet" could mean showing the full six-link nav
 * as low as ~768px (portrait tablet) — measured that against the real
 * content (wordmark + 6 links + CTA) and it doesn't fit without
 * wrapping/cramming at that width. Kept `lg` so "tablet" resolves to
 * landscape-tablet-and-up (1024px = iPad landscape exactly), and
 * anything narrower gets the hamburger instead of a broken nav row.
 *
 * NOTE: phone number is the same placeholder already flagged in
 * Footer.astro (repeated zeros, not a real number) — swap both before
 * launch. Address is a real, correct one (Bradford, West Yorkshire —
 * matches the footer/CLAUDE.md's stated location), not a placeholder.
 */
---

<header>
  <div class="bg-guard-olive-bright">
    <div
      class="mx-auto flex items-center justify-center gap-4 px-gutter py-2 sm:justify-start sm:gap-8 sm:py-2.5 md:px-12"
    >
      <a
        href="tel:+441274000000"
        class="text-micro text-ink hover:text-ink/70 flex items-center gap-2 transition-colors duration-200 ease-out sm:text-caption"
      >
        <Phone class="size-3.5 shrink-0 sm:size-4" />
        01274 000 000
      </a>
      <p class="text-micro text-ink flex items-center gap-2 sm:text-caption">
        <Location class="size-3.5 shrink-0 sm:size-4" />
        Bradford, West Yorkshire
      </p>
    </div>
  </div>

  <div class="border-hairline sticky top-0 z-30 border-b bg-paper">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-gutter py-2.5 md:px-12">
      <a href="/" class="text-wordmark text-ink shrink-0">House of Guards</a>

      <div class="hidden items-center gap-6 lg:flex">
        <nav class="flex items-center gap-6" aria-label="Primary">
          <NavLink href="/">Home</NavLink>
          <NavLink href="/about">About Us</NavLink>
          <NavLink href="/services">Services</NavLink>
          <NavLink href="/careers">Careers</NavLink>
          <NavLink href="/policies">Our Policies</NavLink>
          <NavLink href="/gallery">Gallery</NavLink>
        </nav>

        <Button href="/contact">Get a Quote</Button>
      </div>

      <div class="lg:hidden">
        <NavDrawer client:load />
      </div>
    </div>
  </div>
</header>
