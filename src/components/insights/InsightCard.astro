---
import { Image } from "astro:assets";
import { formatDate, readingMinutes, type Insight } from "../../lib/insights";

/**
 * One article in a list (Insights index, "More insights" on an article).
 * No border or shadow: photo, Amber rule, meta, serif title, summary.
 * Centred on phones, left from sm up (owner's mobile centring rule).
 * The whole card is one link; the title carries the accessible name.
 */
interface Props {
  post: Insight;
  /** Larger heading for the index grid; smaller for related lists. */
  size?: "md" | "sm";
}

const { post, size = "md" } = Astro.props;
const { title, description, date, category, cover, coverAlt } = post.data;
---

<article class="group relative flex flex-col text-center sm:text-left">
  <div class="aspect-[3/2] overflow-hidden bg-surface-alt">
    <Image
      src={cover}
      alt={coverAlt}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
    />
  </div>
  <span class="bg-amber mx-auto mt-6 block h-0.5 w-10 sm:mx-0" aria-hidden="true"></span>
  <p class="text-caption text-stone mt-4">
    {category} · <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingMinutes(post.body)} min read
  </p>
  <h3 class={`text-ink mt-2 ${size === "md" ? "text-h3" : "text-h4"}`}>
    <a href={`/insights/${post.id}/`} class="after:absolute after:inset-0 group-hover:underline decoration-ink/30 underline-offset-4">
      {title}
    </a>
  </h3>
  {size === "md" && <p class="text-body-sm text-stone mt-3">{description}</p>}
</article>
