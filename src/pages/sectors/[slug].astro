---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/ui/Button.astro";
import PageHero from "../../components/page/PageHero.astro";
import QuoteBand from "../../components/page/QuoteBand.astro";
import Chevron from "../../icons/Chevron.astro";
import { SECTORS, type Sector } from "../../data/sectors";

/**
 * The six `/sectors/<slug>` detail pages `SectorsGrid.astro`'s own
 * "Learn more" buttons already link to. One template, `getStaticPaths()`-
 * driven from `src/data/sectors.ts` — the same data `SectorsGrid.astro`
 * uses for its homepage tab panels, so the two never drift out of sync.
 *
 * PR #43 built the STRUCTURE below deliberately shipped WITHOUT content —
 * the "finalized" content draft it arrived with
 * (`sector-pages-content-draft.md`) still had `[[ADD REAL DETAIL]]`
 * markers throughout, including the Healthcare mental-health-crisis FAQ,
 * despite its own status line claiming otherwise. Flagged per that file's
 * own explicit instruction rather than filled in or guessed at. **PR #46
 * activated it for real**, once a genuinely resolved second draft was
 * checked line-by-line and confirmed clean — every sector in
 * `src/data/sectors.ts` now has real `expandedDescription`/`risks`/
 * `approach`/`faqs` content, so every section below now renders on all
 * six pages. Two wordings from that draft are carried verbatim, not
 * paraphrased, per direct instruction: Healthcare's mental-health FAQ
 * states GENERAL de-escalation training only, not specialised
 * mental-health-crisis training; and Healthcare's copy offers the
 * service as available/ready, not as a track record (no prior
 * healthcare-site experience is claimed anywhere on this page). The
 * conditional rendering itself is unchanged and still real, not
 * vestigial — a future sector added before its own copy is ready would
 * still degrade cleanly the same way these six did between PR #43 and
 * #46.
 *
 * NEW SECTIONS (each fully conditional on its own data being present):
 *   - Expanded description — a second, longer paragraph below the hero.
 *   - Risks & challenges — a plain two-column hairline-divided list, NOT
 *     a card grid and NOT numbered (it's a real bulleted list, not a
 *     sequence) — matching `about.astro`'s own fact-list idiom. No icons:
 *     the six existing service icons (building facade, protective-arc
 *     figure, camera, footprints, hard hat, crescent) don't map to
 *     abstract risk concepts like "till security" or "perimeter breach,"
 *     and forcing a fit would mean picking a new icon concept — flagged
 *     to the user rather than quietly done. (There's no pre-existing
 *     "open icon system decision" tracked anywhere in this repo as of
 *     this PR — if one exists elsewhere, fold it in on that basis
 *     directly, not from an assumption made here.)
 *   - FAQ — the ONE section carrying real visual weight on this page, per
 *     direct instruction. An accordion, not a flat list — see
 *     `src/lib/sectorFaqAccordion.ts` for the interaction mechanism.
 *     Rows, not cards: hairline-divided, no shadow, no rounded corners.
 *     The accent (`sector.fill`'s own Electric-Blue/Magenta, or Amber as
 *     a bare mark for the two plain sectors — Corporate/Education —
 *     matching the header-nav/MissionBand-underline precedent for Amber
 *     as a non-fill mark) appears ONLY as a thin left border on whichever
 *     row is currently open, via `group-has-[[aria-expanded="true"]]:` —
 *     no JS-toggled class needed, the CSS keys directly off the same
 *     `aria-expanded` attribute the accordion module sets. The trigger's
 *     own chevron (reusing `Chevron.astro`, not a new icon) rotates the
 *     same way, same variant.
 *
 * SCHEMA.ORG — two kinds of structured data, both using ONLY facts
 * already live elsewhere on this site:
 *   - `Service`, unconditional — `serviceType`, `description` (the
 *     existing `sector.blurb`), a `provider`, and an `areaServed` list
 *     (West Yorkshire, Manchester, Birmingham — see the `areaServed`
 *     constant's own comment below for the full, twice-corrected history
 *     of this field). Deliberately does NOT include a
 *     `telephone` — the phone number in `Header.astro`/`Footer.astro`/
 *     `ClosingCta.astro` (01274 000 000) is a known, already-flagged
 *     placeholder (see `ClosingCta.astro`'s own PR #31 history), and
 *     shipping a fake number into indexed structured data is a real risk,
 *     not a formatting nicety — worth fixing once the real number
 *     exists, not before.
 *   - `FAQPage`, conditional on `sector.faqs` — mirrors the accordion
 *     content exactly (`mainEntity`/`Question`/`acceptedAnswer`). Live on
 *     all six pages as of PR #46, now that every sector has real FAQ
 *     content; stays conditional so a future sector without one yet
 *     wouldn't ship an empty/wrong `FAQPage` block.
 *
 * INTERNAL LINKS / LOCAL SEO — a short paragraph naming two OTHER sectors
 * (the next two in `SECTORS`, wrapping around — deterministic, not
 * hand-curated) as real links, plus a natural Bradford/West Yorkshire
 * mention. Both reuse facts already public elsewhere on the site (no new
 * claim). A link to a `/services` page was also asked for — no such page
 * exists yet (`ServicesGrid.astro` is a homepage section, not its own
 * route) — flagged rather than invented; this paragraph links sectors
 * only until that page exists.
 *
 * MOTION — one deliberate scroll-reveal moment (`[data-reveal]` on
 * whichever of Risks/Why-Us is present), matching every other interior
 * page's own restraint; the FAQ accordion's own open/close animation is
 * interaction-driven, not scroll-triggered, the same category as
 * `sectorsGridTabs.ts`'s crossfade.
 */
export function getStaticPaths() {
  return SECTORS.map((sector, index) => ({
    params: { slug: sector.slug },
    props: {
      sector,
      relatedSectors: [SECTORS[(index + 1) % SECTORS.length], SECTORS[(index + 2) % SECTORS.length]],
    },
  }));
}

interface Props {
  sector: Sector;
  relatedSectors: Sector[];
}

const { sector, relatedSectors } = Astro.props as Props;

const WHY_INTRO = `Every officer we deploy to a ${sector.name.toLowerCase()} site brings the same standards clients rely on across every sector we serve.`;

// Full literal strings, not built via template-literal interpolation —
// Tailwind's scanner does plain-text matching across the compiled source,
// not JS evaluation, so a class name assembled at runtime from a variable
// (e.g. `` `...${accent}` ``) never actually gets generated. Same fixed-
// lookup pattern `SectorsGrid.astro`'s own `PANEL_FILL_CLASS` already uses.
// "plain" (Corporate/Education, no `sector.fill`) reuses Amber as a bare,
// non-fill mark — the same accepted use as the header-nav/MissionBand
// underline, not a new exception.
// Open FAQ row accent: Amber on every sector now (owner moved the public
// site to black/white/grey; the old per-sector Electric Blue / Magenta
// mark is retired). Amber as a bare 2px mark on Paper (~2.15:1) is the
// already-accepted decorative-mark tradeoff (PR #17/#18).
const accentTriggerClass = "group-has-[[aria-expanded='true']]:border-amber";

const hasRisks = Boolean(sector.risks?.length);
const hasFaqs = Boolean(sector.faqs?.length);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  serviceType: `${sector.name} Security`,
  name: `${sector.name} Security | Harley Garrison`,
  description: sector.blurb,
  provider: {
    "@type": "LocalBusiness",
    name: "Harley Garrison",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bradford",
      addressRegion: "West Yorkshire",
      addressCountry: "GB",
    },
  },
  // REPLACES the prior "Bradford and surrounding areas" GeoCircle entirely
  // (second correction to this field — see CLAUDE.md's own PR #44/#45
  // history for the full account of both). Per direct confirmation: West
  // Yorkshire (Leeds, Halifax, Huddersfield, Wakefield, Bradford,
  // Keighley, etc.) is the core named area, PLUS Manchester and
  // Birmingham as genuine current deployable coverage — not future
  // expansion. `areaServed` accepts a LIST of Place/AdministrativeArea
  // entries (schema.org's own documented pattern for a business serving
  // multiple distinct areas) — one `AdministrativeArea` for the whole of
  // West Yorkshire (the named towns are illustrative of what that region
  // covers, not separate schema entries — West Yorkshire alone already
  // captures all of them), plus one `City` entry each for Manchester and
  // Birmingham, each disambiguated with `containedInPlace` since both
  // names exist elsewhere in the world (Manchester, NH; Birmingham, AL).
  // "North West" as a general region is deliberately NOT added here —
  // that's still the broader, unconfirmed future-expansion phrasing from
  // about.astro's Vision paragraph, a separate claim from these three
  // specific, confirmed areas.
  areaServed: [
    {
      "@type": "AdministrativeArea",
      name: "West Yorkshire",
    },
    {
      "@type": "City",
      name: "Manchester",
      containedInPlace: {
        "@type": "Country",
        name: "United Kingdom",
      },
    },
    {
      "@type": "City",
      name: "Birmingham",
      containedInPlace: {
        "@type": "Country",
        name: "United Kingdom",
      },
    },
  ],
};

const faqSchema = hasFaqs
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: sector.faqs!.map((faq) => ({
        "@type": "Question",
        name: faq.question,
        acceptedAnswer: {
          "@type": "Answer",
          text: faq.answer,
        },
      })),
    }
  : null;
---

<BaseLayout title={`${sector.name} Security`} description={sector.blurb}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(serviceSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}

  <PageHero
    eyebrow={`Sectors · ${sector.name}`}
    title={`${sector.name} Security`}
    lead={sector.headline}
    image={sector.photo}
    imageAlt={sector.alt}
  >
    <Button href="/contact/">Get a Quote</Button>
  </PageHero>

  <section class="bg-paper" data-reveal>
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-12 px-gutter pb-20 md:px-12 md:pb-28 lg:grid-cols-12 lg:gap-16">
      <div class="text-center lg:col-span-7 lg:text-left">
        <p class="text-caption text-stone">Overview</p>
        <h2 class="text-h2 text-ink mt-4">How we protect {sector.name.toLowerCase()} sites</h2>
        <p class="text-body-sm text-ink mx-auto mt-6 max-w-xl lg:mx-0">{sector.blurb}</p>
        {
          sector.expandedDescription && (
            <p class="text-body-sm text-stone mx-auto mt-5 max-w-xl lg:mx-0">{sector.expandedDescription}</p>
          )
        }
        <p class="text-caption text-stone mx-auto mt-8 max-w-xl lg:mx-0">
          Based in Bradford, covering {sector.name.toLowerCase()} sites across West Yorkshire — alongside{" "}
          <a href={`/sectors/${relatedSectors[0].slug}/`} class="text-ink underline decoration-hairline underline-offset-2 hover:decoration-ink">{relatedSectors[0].name.toLowerCase()}</a> and{" "}
          <a href={`/sectors/${relatedSectors[1].slug}/`} class="text-ink underline decoration-hairline underline-offset-2 hover:decoration-ink">{relatedSectors[1].name.toLowerCase()}</a> security.
        </p>
      </div>

      <aside class="bg-surface-alt p-8 text-center sm:p-10 lg:col-span-5 lg:text-left">
        <h2 class="text-h3 text-ink">Why Harley Garrison</h2>
        <p class="text-body-sm text-ink mx-auto mt-3 max-w-sm lg:mx-0">{WHY_INTRO}</p>
        <ul class="mt-6 divide-y divide-ink/15 border-y border-ink/15">
          <li class="text-body-sm text-ink py-3.5">SIA licensed and DBS checked officers</li>
          <li class="text-body-sm text-ink py-3.5">First aid trained personnel</li>
          <li class="text-body-sm text-ink py-3.5">Bespoke shift patterns, arranged around you</li>
        </ul>
      </aside>
    </div>
  </section>

  {
    hasRisks && (
      <section class="on-dark bg-ink text-paper">
        <div class="mx-auto max-w-7xl px-gutter py-20 md:px-12 md:py-24">
          <div data-reveal class="text-center lg:text-left">
            <p class="text-caption text-paper/70">The challenge</p>
            <h2 class="text-h2 mx-auto mt-4 max-w-2xl lg:mx-0">
              Risks in {sector.name.toLowerCase()} security
            </h2>
          </div>
          <ul data-reveal class="bg-paper/15 mt-12 grid grid-cols-1 gap-px md:grid-cols-2">
            {sector.risks!.map((risk) => (
              <li class="bg-ink px-8 py-7 text-center md:text-left">
                <span aria-hidden="true" class="bg-amber mx-auto mb-4 block h-0.5 w-6 md:mx-0" />
                <p class="text-body-sm text-paper/80">{risk}</p>
              </li>
            ))}
            {/* Owner: no empty cell. With an odd number of risks the last grid
                cell becomes a short call to action instead of bare gap colour. */}
            {sector.risks!.length % 2 === 1 && (
              <li class="bg-ink flex flex-col items-center justify-center px-8 py-7 text-center md:items-start md:text-left">
                <h3 class="text-h4">Facing any of these on your site?</h3>
                <p class="text-body-sm text-paper/70 mt-2">We'll recommend the right cover and send a tailored quote.</p>
                <div class="mt-5">
                  <Button href="/contact/" size="sm">Get a Quote</Button>
                </div>
              </li>
            )}
          </ul>
          {sector.approach && (
            <div data-reveal class="mt-12 text-center lg:grid lg:grid-cols-12 lg:gap-16 lg:text-left">
              <h3 class="text-h3 lg:col-span-4">Our approach</h3>
              <p class="text-body-sm text-paper/80 mx-auto mt-4 max-w-2xl lg:col-span-8 lg:mx-0 lg:mt-0">{sector.approach}</p>
            </div>
          )}
        </div>
      </section>
    )
  }

  {
    hasFaqs && (
      <section class="bg-paper">
        <div class="mx-auto grid max-w-7xl grid-cols-1 gap-10 px-gutter py-20 md:px-12 md:py-24 lg:grid-cols-12 lg:gap-16">
          <div class="text-center lg:col-span-4 lg:text-left">
            <p class="text-caption text-stone">Questions</p>
            <h2 class="text-h2 text-ink mt-4">Frequently asked questions</h2>
          </div>

          <div class="divide-y divide-hairline border-y border-hairline lg:col-span-8">
            {sector.faqs!.map((faq, i) => (
              <div data-faq-item class="group">
                <button
                  type="button"
                  data-faq-trigger
                  aria-expanded="false"
                  aria-controls={`faq-panel-${sector.slug}-${i}`}
                  id={`faq-trigger-${sector.slug}-${i}`}
                  class:list={[
                    "flex w-full items-center justify-between gap-6 py-6 pl-4 -ml-4 text-left border-l-2 border-transparent transition-colors duration-200 ease-out",
                    accentTriggerClass,
                  ]}
                >
                  <span class="text-h4 text-ink">{faq.question}</span>
                  <Chevron class="size-4 shrink-0 text-ink transition-transform duration-200 ease-out group-has-[[aria-expanded='true']]:rotate-90" />
                </button>
                <div
                  id={`faq-panel-${sector.slug}-${i}`}
                  role="region"
                  aria-labelledby={`faq-trigger-${sector.slug}-${i}`}
                  data-faq-panel
                  class="pl-4"
                >
                  <p class="text-body-sm text-stone max-w-2xl pb-6">{faq.answer}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-gutter pb-4 md:px-12">
      <div class="border-t border-hairline pt-16 text-center lg:text-left">
        <p class="text-caption text-stone">Other sectors</p>
        <h2 class="text-h2 text-ink mt-4">Who else we protect</h2>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
        {
          relatedSectors.map((related) => (
            <a href={`/sectors/${related.slug}/`} class="group block">
              <div class="aspect-[16/9] overflow-hidden">
                <Image
                  src={related.photo}
                  alt=""
                  widths={[480, 768, 1024]}
                  sizes="(min-width: 640px) 45vw, 100vw"
                  class="h-full w-full object-cover transition-transform duration-[900ms] ease-out group-hover:scale-[1.04]"
                  format="webp"
                  quality={78}
                />
              </div>
              <div class="mt-5 text-center sm:text-left">
                <h3 class="text-h3 text-ink">{related.name} Security</h3>
                <span aria-hidden="true" class="bg-amber mx-auto mt-3 block h-0.5 w-8 transition-[width] duration-500 ease-out group-hover:w-14 sm:mx-0" />
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <QuoteBand heading={`Security for your ${sector.name.toLowerCase()} site`} />

  <script>
    import { initScrollReveal } from "../../lib/scrollReveal";
    import { initSectorFaqAccordion } from "../../lib/sectorFaqAccordion";

    document.addEventListener("astro:page-load", () => {
      initScrollReveal();
      initSectorFaqAccordion();
    });
  </script>
</BaseLayout>
