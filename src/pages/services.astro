---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/ui/Button.astro";
import PageHero from "../components/page/PageHero.astro";
import QuoteBand from "../components/page/QuoteBand.astro";
import CorporateSecurity from "../icons/services/CorporateSecurity.astro";
import CloseProtection from "../icons/services/CloseProtection.astro";
import CctvMonitoring from "../icons/services/CctvMonitoring.astro";
import MannedGuarding from "../icons/services/MannedGuarding.astro";
import ConstructionSecurity from "../icons/services/ConstructionSecurity.astro";
import OvernightSecurity from "../icons/services/OvernightSecurity.astro";
import corporatePhoto from "../assets/services/corporate-security.jpg";
import closeProtectionPhoto from "../assets/services/close-protection.jpg";
import cctvPhoto from "../assets/services/cctv.jpg";
import mannedGuardingPhoto from "../assets/services/manned-guarding.jpg";
import constructionPhoto from "../assets/services/construction.jpg";
import overnightPhoto from "../assets/services/overnight.jpg";

/**
 * Services page — premium redesign (2026-10-10, owner: "premium layouts",
 * no black section fills, centred on mobile). Previous version: a sticky
 * side index beside text-only rows, an Ink standards band, and the full
 * ClosingCta form (now on its own /contact/ page).
 *
 * Structure: shared PageHero with a photo → a centred jump list of the six
 * services (the servicesPage.ts module marks the one in view with
 * aria-current) → one editorial split row per service, photo and text
 * alternating sides on lg, stacked and centred on mobile → the shared
 * standards on Surface Alt → QuoteBand.
 *
 * Icons are Ink now (previously Electric Blue / Magenta). Photos are the
 * same stock images the homepage cards use, framed with the same
 * object-position choices. Ink on Paper ~19.4:1, Stone on Paper ~4.6:1,
 * Ink on Surface Alt ~17.8:1.
 */
const SERVICES: {
  id: string;
  name: string;
  intro: string;
  covers: string[];
  Icon: typeof CorporateSecurity;
  photo: ImageMetadata;
  alt: string;
  position: string;
}[] = [
  {
    id: "corporate-security",
    name: "Corporate Security",
    intro:
      "Front-of-house officers, access control and CCTV oversight that reflect the standards of your organisation.",
    covers: ["Front-of-house and reception officers", "Access control and visitor management", "CCTV oversight"],
    Icon: CorporateSecurity,
    photo: corporatePhoto,
    alt: "A visitor checking in with a receptionist at the front desk of a modern office.",
    position: "object-[45%_50%]",
  },
  {
    id: "close-protection",
    name: "Close Protection",
    intro: "Discreet personal protection for individuals, families and visiting guests, at home and in transit.",
    covers: ["Individuals and families", "Visiting guests", "At home and in transit"],
    Icon: CloseProtection,
    photo: closeProtectionPhoto,
    alt: "A man in a dark suit holding open the rear door of a black executive car for a passenger.",
    position: "object-[60%_50%]",
  },
  {
    id: "cctv-monitoring",
    name: "CCTV Monitoring",
    intro: "Round-the-clock camera monitoring with rapid escalation the moment something looks wrong.",
    covers: [
      "Camera monitoring around the clock",
      "Rapid escalation when something looks wrong",
      "Oversight that supports on-site officers",
    ],
    Icon: CctvMonitoring,
    photo: cctvPhoto,
    alt: "An operator seen from behind in a dark control room facing a wall of camera and monitoring screens.",
    position: "object-center",
  },
  {
    id: "manned-guarding",
    name: "Manned Guarding",
    intro:
      "Highly trained, SIA licensed guards providing a visible presence from crowd control to mobile patrol.",
    covers: ["A visible, static presence", "Crowd control and stewarding", "Mobile patrol"],
    Icon: MannedGuarding,
    photo: mannedGuardingPhoto,
    alt: "Two security officers in dark uniforms walking through a busy shopping centre concourse.",
    position: "object-[50%_65%]",
  },
  {
    id: "construction-site-security",
    name: "Construction Site Security",
    intro: "Protecting plant, materials and part-built structures on sites that are a magnet for thieves.",
    covers: ["Plant and machinery", "Materials and stock", "Part-built structures"],
    Icon: ConstructionSecurity,
    photo: constructionPhoto,
    alt: "A row of workers in hard hats and hi-vis vests standing beside a large construction site's foundations.",
    position: "object-center",
  },
  {
    id: "overnight-security",
    name: "Overnight Security",
    intro: "Dedicated night cover for premises that are most vulnerable once the working day ends.",
    covers: [
      "Dedicated night cover",
      "Shift patterns arranged around your site",
      "Mobile patrol where it suits the premises",
    ],
    Icon: OvernightSecurity,
    photo: overnightPhoto,
    alt: "A security officer standing watch in a dimly lit office building lobby at night.",
    position: "object-[12%_50%]",
  },
];

const STANDARDS = [
  { title: "Licensed and vetted", body: "SIA licensed and DBS checked officers." },
  { title: "First aid trained", body: "First aid trained personnel." },
  { title: "Arranged around you", body: "Bespoke shift patterns, built around how your site actually runs." },
];

const DESCRIPTION =
  "Manned guarding, close protection, CCTV monitoring, corporate, construction site and overnight security from Harley Garrison, a Bradford-based company serving West Yorkshire.";
---

<BaseLayout title="Services" description={DESCRIPTION}>
  <div data-services-page>
    <PageHero
      eyebrow="Our services"
      title="Security arranged around you"
      lead="Discreet, professional security for businesses, private clients and events — six services, each built around the site, the people and the hours that matter to you."
      image={mannedGuardingPhoto}
      imageAlt="Two security officers in dark uniforms walking through a busy shopping centre concourse."
      imagePosition="object-[50%_65%]"
    >
      <Button href="/contact/">Get a Quote</Button>
    </PageHero>

    <nav aria-label="Services on this page" class="border-y border-hairline bg-paper">
      <ul class="mx-auto flex max-w-7xl flex-wrap justify-center gap-x-8 gap-y-3 px-gutter py-6 md:px-12 lg:justify-between">
        {
          SERVICES.map(({ id, name }) => (
            <li>
              <a
                href={`#${id}`}
                data-sp-index-link
                class="text-caption text-stone hover:text-ink aria-[current=true]:text-ink aria-[current=true]:border-amber border-b-2 border-transparent pb-1 transition-colors duration-300"
              >
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <section class="bg-paper">
      <div class="mx-auto max-w-7xl px-gutter py-8 md:px-12 md:py-12">
        {
          SERVICES.map(({ id, name, intro, covers, Icon, photo, alt, position }, i) => (
            <article
              id={id}
              data-sp-row
              class="grid scroll-mt-28 grid-cols-1 items-center gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-16"
            >
              <div class:list={["lg:col-span-6", i % 2 === 1 && "lg:order-2"]}>
                <div class="aspect-[4/3] overflow-hidden">
                  <Image
                    src={photo}
                    alt={alt}
                    widths={[480, 768, 1024]}
                    sizes="(min-width: 1024px) 45vw, 100vw"
                    class:list={["h-full w-full object-cover", position]}
                    format="webp"
                    quality={80}
                  />
                </div>
              </div>

              <div class="text-center lg:col-span-6 lg:text-left">
                <div data-sp-row-rule class="bg-amber mx-auto mb-8 h-0.5 w-12 lg:mx-0" />
                <div data-sp-row-icon class="flex justify-center lg:justify-start">
                  <Icon class="text-ink size-11" />
                </div>
                <h2 data-sp-row-part class="text-h2 text-ink mt-6">
                  {name}
                </h2>
                <p data-sp-row-part class="text-body-sm text-stone mx-auto mt-4 max-w-md lg:mx-0">
                  {intro}
                </p>
                <ul class="divide-hairline border-hairline mx-auto mt-8 max-w-md divide-y border-y lg:mx-0">
                  {covers.map((item) => (
                    <li data-sp-row-part class="text-body-sm text-ink py-3.5">
                      {item}
                    </li>
                  ))}
                </ul>
                <div data-sp-row-part class="mt-8">
                  <Button href="/contact/">Request a quote</Button>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="bg-surface-alt">
      <div class="mx-auto max-w-7xl px-gutter py-20 md:px-12 md:py-24">
        <div data-reveal class="text-center lg:text-left">
          <p class="text-caption text-ink">Behind every service</p>
          <h2 class="text-h2 text-ink mx-auto mt-4 max-w-2xl lg:mx-0">The same standard, every shift</h2>
        </div>
        <div class="mt-12 grid grid-cols-1 gap-px bg-hairline md:grid-cols-3">
          {
            STANDARDS.map(({ title, body }) => (
              <div data-reveal class="bg-paper px-8 py-10 text-center md:text-left">
                <span aria-hidden="true" class="bg-amber mx-auto block h-0.5 w-8 md:mx-0" />
                <h3 class="text-h4 text-ink mt-6">{title}</h3>
                <p class="text-body-sm text-stone mx-auto mt-2 max-w-xs md:mx-0">{body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <QuoteBand heading="Not sure which service you need?" body="Tell us about your site and we'll recommend the right cover, with a tailored quote." />
  </div>

  <script>
    import { initServicesPage } from "../lib/servicesPage";
    import { initScrollReveal } from "../lib/scrollReveal";

    document.addEventListener("astro:page-load", () => {
      initServicesPage();
      initScrollReveal();
    });
  </script>
</BaseLayout>
