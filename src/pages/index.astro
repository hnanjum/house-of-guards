---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import StatStrip from "../components/home/StatStrip.astro";
import ServicesGrid from "../components/home/ServicesGrid.astro";
import MissionBand from "../components/home/MissionBand.astro";
import SectorsStrip from "../components/home/SectorsStrip.astro";
import ClosingCta from "../components/home/ClosingCta.astro";
---

<BaseLayout title="Home">
  <Hero />
  <StatStrip />
  <ServicesGrid />
  <MissionBand />
  <SectorsStrip />
  <ClosingCta />

  <script>
    import { initHeroMuster } from "../lib/heroMuster";
    import { initScrollReveal } from "../lib/scrollReveal";
    import { initServicesGridReveal } from "../lib/servicesGridReveal";

    document.addEventListener("astro:page-load", () => {
      initHeroMuster();
      initScrollReveal();
      initServicesGridReveal();
    });
  </script>
</BaseLayout>
