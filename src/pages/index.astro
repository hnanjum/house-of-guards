---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/Hero.astro";
import StatStrip from "../components/home/StatStrip.astro";
import ServicesIndex from "../components/ServicesIndex.astro";
import MissionBand from "../components/home/MissionBand.astro";
import SectorsStrip from "../components/home/SectorsStrip.astro";
import ClosingCta from "../components/home/ClosingCta.astro";
---

<BaseLayout title="Home">
  <Hero />
  <StatStrip />

  <section class="bg-paper">
    <div class="mx-auto max-w-7xl px-gutter py-24 md:px-12">
      <ServicesIndex />
    </div>
  </section>

  <MissionBand />
  <SectorsStrip />
  <ClosingCta />

  <script>
    import { initHeroMuster } from "../lib/heroMuster";

    document.addEventListener("astro:page-load", () => {
      initHeroMuster();
    });
  </script>
</BaseLayout>
